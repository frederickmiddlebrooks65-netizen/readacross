  // Bulk operations for feeds
  app.post(
    "/api/admin/feeds/bulk-action",
    async (req: Request, res: Response) => {
      try {
        const { feedIds, action, data } = req.body;

        if (!Array.isArray(feedIds) || feedIds.length === 0) {
          return res.status(400).json({ message: "Feed IDs are required" });
        }

        let results = [];

        switch (action) {
          case "block":
            for (const feedId of feedIds) {
              const result = await storage.updateNewRSSFeed(parseInt(feedId), {
                isBlocked: true,
              });
              results.push(result);
            }
            break;
          case "unblock":
            for (const feedId of feedIds) {
              const result = await storage.updateNewRSSFeed(parseInt(feedId), {
                isBlocked: false,
              });
              results.push(result);
            }
            break;
          case "delete":
            for (const feedId of feedIds) {
              const result = await storage.deleteNewRSSFeed(parseInt(feedId));
              results.push({ feedId, deleted: result });
            }
            break;
          default:
            return res.status(400).json({ message: "Invalid action" });
        }

        res.json({
          message: `Bulk ${action} completed`,
          results,
          affectedFeeds: feedIds.length,
        });
      } catch (error) {
        console.error("Error performing bulk action:", error);
        res.status(500).json({ message: "Failed to perform bulk action" });
      }
    },
  );

