        return res.status(400).json({ message: "Feed IDs are required" });
      }

      // Validate feed IDs exist
      const feeds = await Promise.all(
        feedIds.map((id) => storage.getRSSFeedById(parseInt(id))),
      );

      const invalidIds = feedIds.filter((id, index) => !feeds[index]);
      if (invalidIds.length > 0) {
        return res.status(400).json({
          message: "Invalid feed IDs",
          invalidIds,
        });
      }

      // Remove duplicates and trigger sync
      const uniqueFeedIds = Array.from(new Set(feedIds));
      console.log(
        `[ADMIN] Triggering manual sync for feeds: ${uniqueFeedIds.join(", ")}`,
      );

      // TODO: Implement actual feed sync logic

      res.json({
        message: "Feed sync triggered",
        feedIds: uniqueFeedIds,
        status: "success",
      });
