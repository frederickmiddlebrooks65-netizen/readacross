  // Evaluate user translation with GPT
  app.post("/api/feedback/evaluate-translation", async (req, res) => {
    try {
      const {
        sentenceId,
        userTranslation,
        sourceLanguage = "English",
        targetLanguage = "Korean",
        userId = 1,
      } = req.body;

      if (!sentenceId || !userTranslation) {
        return res
          .status(400)
          .json({ error: "sentenceId and userTranslation are required" });
      }

      const sentence = await storage.getSentence(sentenceId);
      if (!sentence) {
        return res.status(404).json({ error: "Sentence not found" });
      }

      // GPT evaluation prompt
      const evaluationPrompt = `You are a professional English-Korean translator and language tutor.

Evaluate the following learner-generated translation.

Original English: "${sentence.source}"
User's Korean Translation: "${userTranslation}"

Respond in the following JSON format:

{
  "score": 8,
  "grade": "B+",
  "feedback": "표현이 전반적으로 자연스럽고 의미가 전달됨. 다만 '정확히'라는 표현이 누락되어 원문의 뉘앙스가 약간 빠짐.",
  "suggested_correction": "몇 년 전—정확히 언제였는지는 중요하지 않다—"
}

Please provide constructive, specific feedback focusing on accuracy, naturalness, and Korean expression quality.`;

      try {
        const completion = await openai.chat.completions.create({
          model: "gpt-4",
          messages: [
            {
              role: "system",
              content:
                "You are a professional language tutor providing detailed feedback on translations. Always respond with valid JSON.",
            },
            {
              role: "user",
              content: evaluationPrompt,
            },
          ],
          temperature: 0.3,
          max_tokens: 500,
        });

        const responseText = completion.choices[0]?.message?.content?.trim();
        if (!responseText) {
          throw new Error("Empty response from GPT");
        }

        // Parse GPT response
        let evaluation;
        try {
          evaluation = JSON.parse(responseText);
        } catch (parseError) {
          // Fallback evaluation
          evaluation = {
            score: 7,
            grade: "B",
            feedback: "번역을 완료했습니다. 의미 전달이 잘 되었습니다.",
            suggested_correction: userTranslation,
          };
        }

        // Save translation attempt
        const translationAttempt = await storage.createTranslationAttempt({
          sentenceId,
          userId,
          userTranslation,
          score: evaluation.score,
          grade: evaluation.grade,
          feedback: evaluation.feedback,
          suggestedCorrection: evaluation.suggested_correction,
          backTranslation: null,
          backTranslationFeedback: null,
          practiceMode: "individual",
          mode: "translation",
          timeSpent: null,
          isCorrect: evaluation.score >= 7,
        });

        // Update sentence status and practice count
        await storage.updateSentence(sentenceId, {
          practiced: true,
          lastPracticedAt: new Date(),
          status: evaluation.score >= 8 ? "completed" : "practicing",
          practiceCount: (sentence.practiceCount || 0) + 1,
          userTranslation,
        });

        res.json({
          ...evaluation,
          attemptId: translationAttempt.id,
        });
      } catch (gptError) {
        console.error("GPT evaluation error:", gptError);

        // Fallback evaluation
        const fallbackEvaluation = {
          score: 7,
          grade: "B",
          feedback:
            "번역을 제출해주셔서 감사합니다. 의미 전달이 잘 되었습니다.",
          suggested_correction: userTranslation,
        };

        // Still save the attempt
        const translationAttempt = await storage.createTranslationAttempt({
          sentenceId,
          userId,
          userTranslation,
          score: fallbackEvaluation.score,
          grade: fallbackEvaluation.grade,
          feedback: fallbackEvaluation.feedback,
          suggestedCorrection: fallbackEvaluation.suggested_correction,
          backTranslation: null,
          backTranslationFeedback: null,
          practiceMode: "individual",
          mode: "translation",
          timeSpent: null,
          isCorrect: fallbackEvaluation.score >= 7,
        });

        res.json({
          ...fallbackEvaluation,
          attemptId: translationAttempt.id,
        });
      }
    } catch (error) {
      console.error("Translation evaluation error:", error);
      res.status(500).json({ error: "Failed to evaluate translation" });
    }
  });

  // User-driven back translation endpoint
  app.post("/api/feedback/back-translate", async (req, res) => {
