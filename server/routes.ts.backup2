  // Check for duplicate feeds by URL
  app.post(
    "/api/admin/feeds/check-duplicate",
    async (req: Request, res: Response) => {
      try {
        const { url } = req.body;

        if (!url || typeof url !== "string") {
          return res.status(400).json({ message: "Valid URL is required" });
        }

        const existingFeed = await storage.findExistingFeedByUrl(url);

        if (existingFeed) {
          const subscriptions = await storage.getActiveSubscriptionsForFeed(
            existingFeed.id,
          );
          res.json({
            isDuplicate: true,
            existingFeed,
            subscriptionCount: subscriptions.length,
            message: "기존 피드가 발견되었습니다",
          });
        } else {
          res.json({
            isDuplicate: false,
            message: "새로운 피드입니다",
          });
        }
      } catch (error) {
        console.error("Error checking for duplicate feed:", error);
        res.status(500).json({ message: "Failed to check for duplicate feed" });
      }
    },
  );

