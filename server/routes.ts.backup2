  // Practice a sentence (save user translation and feedback)
  app.post("/api/sentences/:id/practice", async (req, res) => {
    try {
      const sentenceId = parseInt(req.params.id);
      const { userTranslation, feedback } = req.body;

      const updates: any = {
        practiced: true,
        lastPracticedAt: new Date(),
      };

      if (userTranslation) {
        updates.userTranslation = userTranslation;
      }

      if (feedback) {
