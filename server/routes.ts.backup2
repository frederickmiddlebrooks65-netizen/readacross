      res.status(500).json({ message: "Failed to seed NPR articles" });
    }
  });

  // Test NPR article content extraction endpoint
  app.post("/api/npr/test-extraction", async (req: any, res: any) => {
    try {
      const { articleUrl } = req.body;
      if (!articleUrl) {
        return res.status(400).json({ message: "articleUrl required" });
      }

      console.log(`Testing NPR article extraction: ${articleUrl}`);

      // Import and test the NPR content extraction function
      const nprCrawler = await import("./nprCrawler.js");
      const content = await nprCrawler.fetchNPRArticleContent(articleUrl);

      res.json({
        message: "Successfully extracted NPR article content",
        contentLength: content.length,
        preview:
          content.substring(0, 500) + (content.length > 500 ? "..." : ""),
        extractionMethod: "HTML parsing from NPR website",
      });
    } catch (error) {
      console.error("NPR extraction test error:", error);
      res.status(500).json({
        message: "Failed to extract NPR article content",
        error: error instanceof Error ? error.message : String(error),
      });
    }
  });

  // Update existing NPR document with improved content extraction
  app.post("/api/npr/update-document", async (req: any, res: any) => {
    try {
      const { documentId } = req.body;
      if (!documentId) {
        return res.status(400).json({ message: "documentId required" });
      }

      console.log(
        `Updating NPR document with improved extraction: ${documentId}`,
      );

      // Get the existing document
      const document = await storage.getDocument(documentId);
      if (!document || document.source !== "NPR") {
        return res.status(404).json({ message: "NPR document not found" });
      }

      if (!document.originalUrl) {
        return res
          .status(400)
          .json({ message: "Document has no original URL" });
      }

      // Extract improved content
      const nprCrawler = await import("./nprCrawler.js");
      const newContent = await nprCrawler.fetchNPRArticleContent(
        document.originalUrl,
      );

      // If content is significantly longer, update the document
      if (newContent.length > 500) {
        // Process new content into sentences and paragraphs
        const sentences = nprCrawler.splitIntoSentences(newContent);
        const paragraphs = nprCrawler.createParagraphsFromSentences(
          sentences,
          document.title,
        );

        // Get current sentence count for comparison
        const currentDoc = await storage.getDocumentWithParagraphs(documentId);
        const currentSentenceCount =
          currentDoc?.paragraphs.reduce(
            (acc, p) => acc + p.sentences.length,
            0,
          ) || 0;

        // Delete existing content and add new content
        await storage.deleteDocumentContent(documentId);
        await storage.addParagraphsToDocument(documentId, paragraphs);

        console.log(
          `Updated NPR document ${documentId}: ${currentSentenceCount} → ${sentences.length} sentences`,
        );

        res.json({
          message: "Successfully updated document with improved content",
          documentId: documentId,
          title: document.title,
          oldSentenceCount: currentSentenceCount,
          newSentenceCount: sentences.length,
          contentLength: newContent.length,
          preview:
            newContent.substring(0, 500) +
            (newContent.length > 500 ? "..." : ""),
          improvementRatio: Math.round(
            sentences.length / Math.max(currentSentenceCount, 1),
          ),
        });
      } else {
        res.json({
          message: "No significant improvement in content length",
          documentId: documentId,
          title: document.title,
          contentLength: newContent.length,
          preview: newContent.substring(0, 300),
        });
      }
    } catch (error) {
      console.error("NPR document update error:", error);
      res.status(500).json({
        message: "Failed to update NPR document",
