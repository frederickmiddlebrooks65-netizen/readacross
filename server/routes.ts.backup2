      const backTranslationPrompt = `Compare the learner's back translation with the original sentence. 
Return a score (1-10) and brief Korean feedback on whether the meaning is preserved. No corrections needed.

Original English: "${sentence.source}"
AI Korean Translation (Reference): "${sentence.target}"
Learner's Back Translation to English: "${userBackTranslation}"

Task: The learner studied the AI Korean translation and translated it back to English. 
Evaluate how well the back translation preserves the meaning of the original English sentence.

Respond in JSON format:
{
  "score": 8,
  "feedback": "의미가 잘 보존되었습니다. 원문의 핵심 내용이 역번역에서도 잘 전달되고 있습니다."
}

Please provide constructive, specific feedback focusing on accuracy, naturalness, and Korean expression quality.`;

      try {
        const completion = await openai.chat.completions.create({
          model: "gpt-4",
          messages: [
            {
              role: "system",
              content:
