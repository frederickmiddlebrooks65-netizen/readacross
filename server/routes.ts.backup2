  // Get practice statistics for Practice Hub
  app.get("/api/practice/stats", async (req, res) => {
    try {
      const userId = 1; // TODO: Get from auth

      // Get all user sentences
      const allSentences = await storage.getAllSentences();
      const userSentences = allSentences.filter((s) => s.isScrapped);

      // Get practice attempts
      const practiceData = await Promise.all(
        userSentences.map(async (sentence) => {
          const attempts = await storage.getTranslationAttempts(
            sentence.id,
            userId,
          );
          return {
            sentence,
            attempts,
            lastAttempt: attempts[0] || null,
            practiceCount: attempts.length,
            averageScore:
              attempts.length > 0
                ? attempts.reduce((sum, a) => sum + (a.score || 0), 0) /
                  attempts.length
                : 0,
          };
        }),
      );

      const practicedSentences = practiceData.filter(
        (p) => p.practiceCount > 0,
      );
      const totalScore = practicedSentences.reduce(
        (sum, p) => sum + p.averageScore,
        0,
      );
      const averageScore =
        practicedSentences.length > 0
          ? totalScore / practicedSentences.length
          : 0;

      // Find weak sentences (low scores or need more practice)
      const weakSentences = practiceData
        .filter((p) => p.lastAttempt && (p.lastAttempt.score || 0) < 7)
        .sort(
          (a, b) => (a.lastAttempt?.score || 0) - (b.lastAttempt?.score || 0),
        )
        .slice(0, 10)
        .map((p) => ({
          id: p.sentence.id,
          source: p.sentence.source,
          lastScore: p.lastAttempt?.score || 0,
          practiceCount: p.practiceCount,
        }));

      // Calculate streak (simplified - just check if practiced today)
      const today = new Date().toDateString();
      const practicedToday = practicedSentences.some(
        (p) =>
          p.lastAttempt &&
          new Date(p.lastAttempt.createdAt).toDateString() === today,
      );

      // Calculate weekly progress (last 7 days)
      const weekAgo = new Date();
      weekAgo.setDate(weekAgo.getDate() - 7);

      const weeklyPractice = practiceData.filter(
        (p) => p.lastAttempt && new Date(p.lastAttempt.createdAt) >= weekAgo,
      );

      // Calculate learning trend (compare this week vs last week)
      const twoWeeksAgo = new Date();
      twoWeeksAgo.setDate(twoWeeksAgo.getDate() - 14);

      const lastWeekPractice = practiceData.filter(
        (p) =>
          p.lastAttempt &&
          new Date(p.lastAttempt.createdAt) >= twoWeeksAgo &&
          new Date(p.lastAttempt.createdAt) < weekAgo,
      );

      const weeklyProgress = weeklyPractice.length;
      const lastWeekProgress = lastWeekPractice.length;

      let learningTrendDirection: "up" | "down" | "stable" = "stable";
      let trendPercentage = 0;

      if (lastWeekProgress > 0) {
        const change =
          ((weeklyProgress - lastWeekProgress) / lastWeekProgress) * 100;
        trendPercentage = Math.abs(Math.round(change));

        if (change > 10) learningTrendDirection = "up";
        else if (change < -10) learningTrendDirection = "down";
      } else if (weeklyProgress > 0) {
        learningTrendDirection = "up";
        trendPercentage = 100;
      }

      const stats = {
        totalSentences: userSentences.length,
        practicedSentences: practicedSentences.length,
        averageScore: Math.round(averageScore * 10) / 10,
        streakDays: practicedToday ? 1 : 0, // Simplified streak calculation
        weakSentences,
        recentActivity: practicedSentences.slice(0, 5).map((p) => ({
          sentence: p.sentence.source,
          score: p.lastAttempt?.score,
          date: p.lastAttempt?.createdAt,
        })),
        accuracyTrend: [], // TODO: Implement trend analysis
        practicesByDay: {}, // TODO: Implement daily practice tracking
        // New fields for enhanced Practice Hub
        weeklyProgress,
        weeklyGoal: 7,
        learningTrendDirection,
        trendPercentage,
        reviewNeeded: weakSentences.length,
      };

      res.json(stats);
    } catch (error) {
      console.error("Error fetching practice stats:", error);
      res.status(500).json({ error: "Failed to fetch practice statistics" });
    }
  });

  // Get daily review recommendations
  app.get("/api/recommendations/daily-review", async (req, res) => {
    try {
      const userId = 1; // TODO: Get from auth
      const limit = parseInt(req.query.limit as string) || 5;

      // Get all user sentences
      const allSentences = await storage.getAllSentences();
      const userSentences = allSentences.filter((s) => s.isScrapped);

      // Get practice attempts for recommendation algorithm
      const practiceData = await Promise.all(
        userSentences.map(async (sentence) => {
          const attempts = await storage.getTranslationAttempts(
            sentence.id,
            userId,
          );
          const lastAttempt = attempts[0] || null;
          const daysSinceLastPractice = lastAttempt
            ? Math.floor(
                (Date.now() - new Date(lastAttempt.createdAt).getTime()) /
                  (1000 * 60 * 60 * 24),
              )
            : 999;

          return {
            sentence,
            attempts,
            lastAttempt,
            practiceCount: attempts.length,
            averageScore:
              attempts.length > 0
                ? attempts.reduce((sum, a) => sum + (a.score || 0), 0) /
                  attempts.length
                : 0,
            daysSinceLastPractice,
          };
        }),
      );

      // Recommendation algorithm: prioritize by low score, long gap, or never practiced
      const recommendations = practiceData
        .map((p) => {
          let priority = 0;
          let reason: "low_score" | "not_practiced" | "long_gap" =
            "not_practiced";

          if (p.practiceCount === 0) {
            priority = 10; // Never practiced - highest priority
            reason = "not_practiced";
          } else if (p.lastAttempt && (p.lastAttempt.score || 0) < 7) {
            priority = 8 - (p.lastAttempt.score || 0); // Low score priority
            reason = "low_score";
          } else if (p.daysSinceLastPractice > 3) {
            priority = Math.min(p.daysSinceLastPractice / 2, 6); // Long gap priority
            reason = "long_gap";
          }

          return {
            id: p.sentence.id,
            source: p.sentence.source,
            translation: p.sentence.target,
            aiTranslation: p.sentence.target,
            reason,
            lastScore: p.lastAttempt?.score,
            daysSinceLastPractice: p.daysSinceLastPractice,
            priority,
          };
        })
        .filter((r) => r.priority > 0)
        .sort((a, b) => b.priority - a.priority)
        .slice(0, limit);

      res.json({ recommendations });
    } catch (error) {
      console.error("Error getting daily review recommendations:", error);
      res.status(500).json({ error: "Failed to get recommendations" });
    }
  });

  // Get weak sentences for focused practice
  app.get("/api/recommendations/weak-sentences", async (req, res) => {
    try {
      const userId = 1; // TODO: Get from auth
      const limit = parseInt(req.query.limit as string) || 10;

      // Get all user sentences
      const allSentences = await storage.getAllSentences();
      const userSentences = allSentences.filter((s) => s.isScrapped);

      // Get practice attempts
      const practiceData = await Promise.all(
        userSentences.map(async (sentence) => {
          const attempts = await storage.getTranslationAttempts(
            sentence.id,
            userId,
          );
          return {
            sentence,
            attempts,
            lastAttempt: attempts[0] || null,
            practiceCount: attempts.length,
            averageScore:
              attempts.length > 0
                ? attempts.reduce((sum, a) => sum + (a.score || 0), 0) /
                  attempts.length
                : 0,
          };
        }),
      );

      // Find sentences with low scores or consistency issues
      const weakSentences = practiceData
        .filter((p) => p.lastAttempt && (p.lastAttempt.score || 0) < 7)
        .sort(
          (a, b) => (a.lastAttempt?.score || 0) - (b.lastAttempt?.score || 0),
        )
        .slice(0, limit)
        .map((p) => ({
          id: p.sentence.id,
          source: p.sentence.source,
          target: p.sentence.target,
          lastScore: p.lastAttempt?.score || 0,
          practiceCount: p.practiceCount,
          averageScore: Math.round(p.averageScore * 10) / 10,
          needsAttention:
            (p.lastAttempt?.score || 0) < 5 ? "urgent" : "moderate",
        }));

      res.json({ weakSentences });
    } catch (error) {
      console.error("Error getting weak sentences:", error);
      res.status(500).json({ error: "Failed to get weak sentences" });
    }
  });

  // Quick practice: Get random sentences for fast practice session
  app.get("/api/practice/quick-sentences", async (req, res) => {
    try {
      const userId = 1; // TODO: Get from auth
      const count = parseInt(req.query.count as string) || 3;

      // Get all user sentences
      const allSentences = await storage.getAllSentences();
      const userSentences = allSentences.filter((s) => s.isScrapped);

      if (userSentences.length === 0) {
        return res.json({ sentences: [] });
      }

      // Shuffle and pick random sentences
      const shuffled = [...userSentences].sort(() => Math.random() - 0.5);
      const selectedSentences = shuffled.slice(
        0,
        Math.min(count, userSentences.length),
      );

      res.json({ sentences: selectedSentences });
    } catch (error) {
      console.error("Error getting quick practice sentences:", error);
      res.status(500).json({ error: "Failed to get quick practice sentences" });
