  // Seed NPR articles endpoint
  app.post("/api/npr/seed", async (req: any, res: any) => {
    try {
      const { maxArticles = 10 } = req.body;

      console.log(
        `Starting NPR articles seeding with max ${maxArticles} articles`,
      );
      await seedNPRArticles(maxArticles);

      res.json({
