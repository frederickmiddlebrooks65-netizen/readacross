  // Glossary/Word Learning routes

  // Get word learning statistics
  app.get("/api/glossary/stats", async (req, res) => {
    try {
      const userId = 1; // TODO: Get from auth

      const glossaryWords = await storage.getAllGlossaryEntries();
      const userWords = glossaryWords.filter((w) => w.userId === userId);

      if (userWords.length === 0) {
        return res.json({
          totalWords: 0,
          masteredWords: 0,
          studyingWords: 0,
          weeklyProgress: 0,
          averageAccuracy: 0,
        });
      }

      const masteredWords = userWords.filter(
        (w) => (w.masteryLevel || 1) >= 4,
      ).length;
      const studyingWords = userWords.filter(
        (w) => (w.masteryLevel || 1) < 4 && (w.correctCount || 0) > 0,
      ).length;

      const totalAttempts = userWords.reduce(
        (sum, w) => sum + (w.correctCount || 0) + (w.incorrectCount || 0),
        0,
      );
      const totalCorrect = userWords.reduce(
        (sum, w) => sum + (w.correctCount || 0),
        0,
      );
      const averageAccuracy =
        totalAttempts > 0
          ? Math.round((totalCorrect / totalAttempts) * 100)
          : 0;

      res.json({
        totalWords: userWords.length,
        masteredWords,
        studyingWords,
        weeklyProgress: Math.min(
          studyingWords + masteredWords,
          userWords.length,
        ),
        averageAccuracy,
      });
    } catch (error) {
      console.error("Error fetching word stats:", error);
      res.status(500).json({ error: "Failed to fetch word statistics" });
    }
  });

  // Get practice words for flashcard/quiz mode
  app.get("/api/glossary/practice-words", async (req, res) => {
    try {
      const userId = 1; // TODO: Get from auth
      const limit = parseInt(req.query.limit as string) || 20;

      const glossaryWords = await storage.getAllGlossaryEntries();
      const userWords = glossaryWords.filter((w) => w.userId === userId);

      // Prioritize words that need practice: low mastery level, due for review, or never practiced
      const practiceWords = userWords
        .filter((w) => {
          const masteryLevel = w.masteryLevel || 1;
          const nextReview = w.nextReviewDate
            ? new Date(w.nextReviewDate)
            : null;
          const now = new Date();

          return (
            masteryLevel < 4 ||
            (nextReview && nextReview <= now) ||
            !w.reviewCount
          );
        })
        .sort((a, b) => {
          // Sort by priority: mastery level (ascending), then by review date
          const aMastery = a.masteryLevel || 1;
          const bMastery = b.masteryLevel || 1;
          if (aMastery !== bMastery) return aMastery - bMastery;

          const aReview = a.nextReviewDate
            ? new Date(a.nextReviewDate).getTime()
            : 0;
          const bReview = b.nextReviewDate
            ? new Date(b.nextReviewDate).getTime()
            : 0;
          return aReview - bReview;
        })
        .slice(0, limit);

      res.json(practiceWords);
    } catch (error) {
      console.error("Error fetching practice words:", error);
      res.status(500).json({ error: "Failed to fetch practice words" });
    }
  });

  // Record word practice session
  app.post("/api/glossary/practice", async (req, res) => {
    try {
      const userId = 1; // TODO: Get from auth
      const {
        wordId,
        sessionType,
        isCorrect,
        timeSpent,
        questionType,
        selectedAnswer,
        correctAnswer,
      } = req.body;

      if (!wordId || !sessionType || typeof isCorrect !== "boolean") {
        return res
          .status(400)
          .json({ error: "wordId, sessionType, and isCorrect are required" });
      }

      // Get current word data
      const word = await storage.getGlossaryEntry(wordId);
      if (!word) {
        return res.status(404).json({ error: "Word not found" });
      }

      // Update word statistics
      const newCorrectCount = (word.correctCount || 0) + (isCorrect ? 1 : 0);
      const newIncorrectCount =
        (word.incorrectCount || 0) + (isCorrect ? 0 : 1);
      const totalAttempts = newCorrectCount + newIncorrectCount;
      const accuracy = totalAttempts > 0 ? newCorrectCount / totalAttempts : 0;

      // Calculate new mastery level (1-5 scale)
      let newMasteryLevel = word.masteryLevel || 1;
      if (totalAttempts >= 3) {
        if (accuracy >= 0.9) newMasteryLevel = Math.min(5, newMasteryLevel + 1);
        else if (accuracy >= 0.8)
          newMasteryLevel = Math.max(1, Math.min(4, newMasteryLevel));
        else if (accuracy < 0.6)
          newMasteryLevel = Math.max(1, newMasteryLevel - 1);
      }

      // Calculate next review date using spaced repetition
      const now = new Date();
      const intervals = [1, 3, 7, 14, 30]; // days
      const intervalIndex = Math.min(newMasteryLevel - 1, intervals.length - 1);
      const nextReviewDate = new Date(
        now.getTime() + intervals[intervalIndex] * 24 * 60 * 60 * 1000,
      );

      // Update word in glossary
      await storage.updateGlossaryEntry(wordId, {
        correctCount: newCorrectCount,
        incorrectCount: newIncorrectCount,
        masteryLevel: newMasteryLevel,
        nextReviewDate,
        lastReviewed: now,
        reviewCount: (word.reviewCount || 0) + 1,
      });

      // Record practice session
      await storage.createWordPracticeSession({
        userId,
        wordId,
        sessionType,
        isCorrect,
        timeSpent: timeSpent || null,
        questionType: questionType || null,
        selectedAnswer: selectedAnswer || null,
        correctAnswer: correctAnswer || null,
      });

      res.json({
        success: true,
        newMasteryLevel,
        accuracy: Math.round(accuracy * 100),
        nextReviewDate,
      });
    } catch (error) {
      console.error("Error recording word practice:", error);
      res.status(500).json({ error: "Failed to record practice session" });
    }
  });

  // Generate quiz questions with distractors
  app.post("/api/glossary/generate-quiz", async (req, res) => {
    try {
      const { wordIds } = req.body;

      if (!wordIds || !Array.isArray(wordIds)) {
        return res.status(400).json({ error: "wordIds array is required" });
      }

      const questions = await Promise.all(
        wordIds.map(async (wordId) => {
          const word = await storage.getGlossaryEntry(wordId);
          if (!word) return null;

          // Get all words to generate distractors
          const allWords = await storage.getAllGlossaryEntries();
          const potentialDistractors = allWords.filter(
            (w) =>
              w.id !== wordId &&
              w.targetLanguage === word.targetLanguage &&
              (w.translation || w.definition || w.term), // Must have a valid answer
          );

          // If not enough words with same difficulty, include other difficulties
          let distractorCandidates = potentialDistractors.filter(
            (w) => w.difficulty === word.difficulty,
          );
          if (distractorCandidates.length < 3) {
            distractorCandidates = potentialDistractors;
          }

          // Generate 3 distractors
          const distractors = distractorCandidates
            .sort(() => Math.random() - 0.5)
            .slice(0, 3)
            .map((w) => w.translation || w.definition || w.term)
            .filter((d) => d && d.trim().length > 0); // Remove empty strings

          // Ensure we have unique options
          const correctAnswer =
            word.translation || word.definition || word.term;

          // If we don't have enough distractors, create some basic ones
          const fallbackDistractors = [
            "정보",
            "기술",
            "시스템",
            "방법",
            "과정",
            "결과",
            "상태",
            "구조",
            "기능",
            "특성",
          ].filter((d) => d !== correctAnswer);

          const finalDistractors = [...distractors];
          while (
            finalDistractors.length < 3 &&
            fallbackDistractors.length > 0
          ) {
            const fallback = fallbackDistractors.pop();
            if (fallback && !finalDistractors.includes(fallback)) {
              finalDistractors.push(fallback);
            }
          }

          const options = [correctAnswer, ...finalDistractors].slice(0, 4);

          // Shuffle options
          const shuffledOptions = options.sort(() => Math.random() - 0.5);

          return {
            id: word.id,
            word: word.term,
            correctAnswer,
            options: shuffledOptions,
            questionType: "meaning",
          };
        }),
      );

      const validQuestions = questions.filter((q) => q !== null);

      res.json({ questions: validQuestions });
    } catch (error) {
      console.error("Error generating quiz questions:", error);
      res.status(500).json({ error: "Failed to generate quiz questions" });
    }
  });

