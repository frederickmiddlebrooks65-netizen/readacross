        case "healthy":
          feeds = await storage.getHealthyFeeds();
          break;
        case "unhealthy":
          feeds = await storage.getUnhealthyFeeds();
          break;
        default:
          const [healthy, unhealthy] = await Promise.all([
            storage.getHealthyFeeds(),
            storage.getUnhealthyFeeds(),
          ]);
          feeds = { healthy, unhealthy };
      }

      res.json(feeds);
    } catch (error) {
