  // Rate limiters for RSS endpoints
  const rssManagementLimiter = rateLimit({
    windowMs: 15 * 60 * 1000, // 15분
    max: 10, // 15분당 최대 10회 요청
    message: {
      error: "너무 많은 요청입니다. 잠시 후 다시 시도해주세요.",
      code: "RATE_LIMIT_EXCEEDED",
      retryAfter: "15분",
    },
    standardHeaders: true,
    legacyHeaders: false,
  });

  const rssSyncLimiter = rateLimit({
    windowMs: 5 * 60 * 1000, // 5분
    max: 3, // 5분당 최대 3회 수동 동기화
    message: {
      error: "동기화 요청이 너무 빈번합니다. 잠시 후 다시 시도해주세요.",
      code: "SYNC_RATE_LIMIT_EXCEEDED",
      retryAfter: "5분",
    },
  });

  // RSS 피드 유효성 검사 스키마 (API 요청용)
  const rssAddRequestSchema = z.object({
    feedUrl: z
      .string()
      .url("유효한 URL을 입력해주세요")
      .regex(/^https?:\/\/.+/, "HTTP 또는 HTTPS URL만 허용됩니다")
      .max(500, "URL이 너무 깁니다"),
    alias: z.string().max(100, "피드 이름이 너무 깁니다").optional(),
    category: z.string().max(50, "카테고리 이름이 너무 깁니다").optional(),
    language: z.string().max(10, "언어 코드가 너무 깁니다").optional(),
    syncInterval: z
      .number()
      .min(1, "동기화 간격은 최소 1시간입니다")
      .max(168, "동기화 간격은 최대 7일(168시간)입니다")
      .optional(),
    isActive: z.boolean().optional(),
  });

  // RSS 피드 등록 (JWT 인증 필요)
  app.post(
    "/api/rss-feeds",
    rssManagementLimiter,
    mockAuthenticateJWT,
    async (req: AuthenticatedRequest, res: Response) => {
      try {
        const validatedData = rssAddRequestSchema.parse(req.body);

        // RSS 피드 유효성 검사
        const validation = await validateRSSFeed(validatedData.feedUrl);
        if (!validation.isValid) {
          return res.status(400).json({
            error: validation.error || "RSS 피드를 파싱할 수 없습니다",
            code: "INVALID_FEED",
          });
        }

        // RSS 피드 생성 (새로운 시스템 사용)
        const feedTitle = validation.title || "RSS Feed";

        // 1. RSS 피드 생성 또는 기존 피드 가져오기
        const rssFeed = await storage.createOrGetFeed(validatedData.feedUrl, {
          title: feedTitle,
          language: validatedData.language || "en",
          category: validatedData.category || "News",
        });

        // 2. 사용자 구독 생성
        const newSubscription = await storage.createRSSSubscription({
          feedId: rssFeed.id,
          userId: req.userId!,
          alias:
            validatedData.alias && validatedData.alias.trim()
              ? validatedData.alias
              : feedTitle,
          visibility: "private",
          enabled: true,
          userTags: null,
          notifyPolicy: "none",
          syncInterval: validatedData.syncInterval || 12,
        });

        // 즉시 첫 동기화 시도
        try {
          await processRSSArticles(rssFeed.id);
        } catch (syncError) {
          console.warn("Initial sync failed:", syncError);
          // 동기화 실패해도 피드 생성은 성공으로 처리
        }

        res.status(201).json({
          ...newSubscription,
          feed: rssFeed,
          message: "RSS 피드가 성공적으로 등록되었습니다",
          validation: {
            title: validation.title,
            itemCount: validation.itemCount,
          },
        });
      } catch (error) {
        if (error instanceof z.ZodError) {
          return res.status(400).json({
            error: "입력 데이터가 유효하지 않습니다",
            details: error.errors.map((e) => ({
              field: e.path.join("."),
              message: e.message,
            })),
          });
        }
        console.error("Error creating RSS feed:", error);
        res.status(500).json({ error: "RSS 피드 등록 중 오류가 발생했습니다" });
      }
    },
  );

  // 사용자 RSS 피드 목록 조회
  app.get(
    "/api/rss-feeds",
    mockAuthenticateJWT,
    async (req: AuthenticatedRequest, res: Response) => {
      try {
        const feeds = await storage.getRSSFeeds(req.userId!);
        res.json(feeds);
      } catch (error) {
        console.error("Error fetching RSS feeds:", error);
        res.status(500).json({ error: "RSS 피드 목록을 가져올 수 없습니다" });
      }
    },
  );

  // RSS 피드 수정
  app.put(
    "/api/rss-feeds/:id",
    rssManagementLimiter,
    mockAuthenticateJWT,
    async (req: AuthenticatedRequest, res: Response) => {
      try {
        const feedId = parseInt(req.params.id);
        if (isNaN(feedId)) {
          return res.status(400).json({ error: "유효하지 않은 피드 ID입니다" });
        }

        // 소유권 확인
        const feed = await storage.getRSSFeed(feedId);
        if (!feed || feed.userId !== req.userId) {
          return res.status(403).json({
            error: "해당 피드에 대한 권한이 없습니다",
            code: "ACCESS_DENIED",
          });
        }

        const updateData = {
          alias: req.body.alias,
          category: req.body.category,
          language: req.body.language,
          syncInterval: req.body.syncInterval,
          isActive: req.body.isActive,
        };

        // undefined 값 제거
        Object.keys(updateData).forEach((key) => {
          if (updateData[key as keyof typeof updateData] === undefined) {
            delete updateData[key as keyof typeof updateData];
          }
        });

        const updatedFeed = await storage.updateRSSFeed(feedId, updateData);
        if (!updatedFeed) {
          return res.status(404).json({ error: "피드를 찾을 수 없습니다" });
        }

        res.json({
          ...updatedFeed,
          message: "RSS 피드가 성공적으로 수정되었습니다",
        });
      } catch (error) {
        console.error("Error updating RSS feed:", error);
        res.status(500).json({ error: "RSS 피드 수정 중 오류가 발생했습니다" });
      }
    },
  );

  // RSS 피드 삭제
  app.delete(
    "/api/rss-feeds/:id",
    rssManagementLimiter,
    mockAuthenticateJWT,
    async (req: AuthenticatedRequest, res: Response) => {
      try {
        const feedId = parseInt(req.params.id);
        if (isNaN(feedId)) {
          return res.status(400).json({ error: "유효하지 않은 피드 ID입니다" });
        }

        // 소유권 확인
        const feed = await storage.getRSSFeed(feedId);
        if (!feed || feed.userId !== req.userId) {
          return res.status(403).json({
            error: "해당 피드에 대한 권한이 없습니다",
            code: "ACCESS_DENIED",
          });
        }

        const success = await storage.deleteRSSFeed(feedId);
        if (!success) {
          return res.status(500).json({ error: "피드 삭제에 실패했습니다" });
        }

        res.json({ message: "RSS 피드가 성공적으로 삭제되었습니다" });
      } catch (error) {
        console.error("Error deleting RSS feed:", error);
        res.status(500).json({ error: "RSS 피드 삭제 중 오류가 발생했습니다" });
      }
    },
  );

  // 수동 동기화 트리거
  app.post(
    "/api/rss-feeds/:id/sync",
    rssSyncLimiter,
    mockAuthenticateJWT,
    async (req: AuthenticatedRequest, res: Response) => {
      try {
        const feedId = parseInt(req.params.id);
        if (isNaN(feedId)) {
          return res.status(400).json({ error: "유효하지 않은 피드 ID입니다" });
        }

        // 소유권 확인
        const feed = await storage.getRSSFeed(feedId);
        if (!feed || feed.userId !== req.userId) {
          return res.status(403).json({
            error: "해당 피드에 대한 권한이 없습니다",
            code: "ACCESS_DENIED",
          });
        }

        if (!feed.enabled) {
          return res
            .status(400)
            .json({ error: "비활성화된 피드는 동기화할 수 없습니다" });
        }

        // 동기화 실행
        await processRSSArticles(feedId);

        res.json({
          message: "RSS 피드 동기화가 완료되었습니다",
          feedId: feedId,
          syncTime: new Date().toISOString(),
        });
      } catch (error) {
        console.error("Error syncing RSS feed:", error);
        res
          .status(500)
          .json({ error: "RSS 피드 동기화 중 오류가 발생했습니다" });
      }
    },
  );

  // RSS 피드 유효성 검사
  app.post(
    "/api/rss-feeds/validate",
    mockAuthenticateJWT,
    async (req: AuthenticatedRequest, res: Response) => {
      try {
        const { feedUrl } = req.body;
        if (!feedUrl) {
          return res.status(400).json({ error: "RSS 피드 URL이 필요합니다" });
        }

        const validation = await validateRSSFeed(feedUrl);
        res.json(validation);
      } catch (error) {
        console.error("Error validating RSS feed:", error);
        res.status(500).json({ error: "RSS 피드 검증 중 오류가 발생했습니다" });
      }
    },
  );

  // RSS 아티클 목록 조회
  app.get(
    "/api/rss-feeds/:id/articles",
    mockAuthenticateJWT,
    async (req: AuthenticatedRequest, res: Response) => {
      try {
        const feedId = parseInt(req.params.id);
        if (isNaN(feedId)) {
          return res.status(400).json({ error: "유효하지 않은 피드 ID입니다" });
        }

        // 소유권 확인
        const feed = await storage.getRSSFeed(feedId);
        if (!feed || feed.userId !== req.userId) {
          return res
            .status(403)
            .json({ error: "해당 피드에 대한 권한이 없습니다" });
        }

        const articles = await storage.getRSSArticles(feedId);
        res.json(articles);
      } catch (error) {
        console.error("Error fetching RSS articles:", error);
        res.status(500).json({ error: "RSS 아티클 목록을 가져올 수 없습니다" });
      }
    },
  );

  // RSS 아티클을 문서로 변환
  app.post(
    "/api/rss-articles/:id/convert",
    mockAuthenticateJWT,
    async (req: AuthenticatedRequest, res: Response) => {
      try {
        const articleId = parseInt(req.params.id);
        if (isNaN(articleId)) {
          return res
            .status(400)
            .json({ error: "유효하지 않은 아티클 ID입니다" });
        }

        // 아티클 및 소유권 확인
        const article = await storage.getRSSArticle(articleId);
        if (!article) {
          return res.status(404).json({ error: "아티클을 찾을 수 없습니다" });
        }

        const feed = await storage.getRSSFeed(article.feedId);
        if (!feed || feed.userId !== req.userId) {
          return res
            .status(403)
            .json({ error: "해당 아티클에 대한 권한이 없습니다" });
        }

        const documentId = await convertRSSArticleToDocument(articleId);
        if (!documentId) {
          return res.status(500).json({ error: "문서 변환에 실패했습니다" });
        }

        res.json({
          message: "RSS 아티클이 성공적으로 문서로 변환되었습니다",
          documentId: documentId,
          articleId: articleId,
        });
      } catch (error) {
        console.error("Error converting RSS article:", error);
        res
          .status(500)
          .json({ error: "RSS 아티클 변환 중 오류가 발생했습니다" });
      }
    },
  );

  // Save document to library from explore
  app.post("/api/library/save", async (req: Request, res: Response) => {
    console.log("[SAVE_TO_LIBRARY] Save to library request received");

    const {
      documentId,
      title,
      author,
      sourceLanguage,
      targetLanguage,
      sourceType,
      origin,
    } = req.body;

    if (!title) {
      return res.status(400).json({ error: "Title is required" });
    }

    if (!documentId) {
      return res.status(400).json({ error: "Document ID is required" });
    }

    try {
      // Get the original document with its paragraphs and sentences
      const originalDoc = await storage.getDocumentWithParagraphs(documentId);
      if (!originalDoc) {
        return res.status(404).json({ error: "Original document not found" });
      }

      // Check if document already exists in user's library (only active documents)
      const existingUploadDocs = await storage.getUserUploadDocuments({
        status: "active",
      });
      const existingSavedDocs = await storage.getUserSavedDocuments({
        status: "active",
      });
      const allUserDocs = [...existingUploadDocs, ...existingSavedDocs];

      const existingDoc = allUserDocs.find(
        (doc: any) => doc.title === title && doc.author === author,
      );

      if (existingDoc) {
        return res.status(409).json({
          error: "Document already exists in library",
          message: "This document has already been saved to your library",
        });
      }

      // Create new document in library with sourceType 'explore'
      const newDocument = await storage.createDocumentWithParagraphs({
        title,
        sourceLanguage: originalDoc.sourceLanguage,
        targetLanguage: originalDoc.targetLanguage,
        userId: 1,
        fileType: originalDoc.fileType || "text",
        sourceType: "explore",
        author: originalDoc.author || undefined,
        source: originalDoc.source || undefined,
        category: originalDoc.category || undefined,
        difficulty: originalDoc.difficulty || undefined,
        tags: originalDoc.tags || undefined,
        originalUrl: originalDoc.originalUrl || undefined,
        licenseType: originalDoc.licenseType || undefined,
        isPublic: false,
        paragraphs: (originalDoc.paragraphs || []).map((p: any) => ({
          order: p.order,
          title: p.title || null,
          sentences: (p.sentences || []).map((s: any) => ({
            order: s.order,
            source: s.source,
            target: s.target || undefined,
          })),
        })),
      });

      // Copy thumbnail information separately after document creation
      if (
        originalDoc.thumbnailUrl ||
        originalDoc.thumbnailPath ||
        originalDoc.thumbnailStatus
      ) {
        await storage.updateDocument(newDocument.id, {
          thumbnailUrl: originalDoc.thumbnailUrl || undefined,
          thumbnailPath: originalDoc.thumbnailPath || undefined,
          thumbnailStatus: originalDoc.thumbnailStatus || undefined,
          originalImageUrl: originalDoc.originalImageUrl || undefined,
          dominantColor: originalDoc.dominantColor || undefined,
        });
      }

      console.log(
        "[SAVE_TO_LIBRARY] Document saved successfully:",
        newDocument.id,
      );
      res.json({ success: true, document: newDocument });
    } catch (error) {
      console.error("[SAVE_TO_LIBRARY] Error saving document:", error);
      res.status(500).json({ error: "Failed to save document to library" });
    }
  });

  // Get explore content (RSS + system sources)
  app.get("/api/library/explore", async (req: Request, res: Response) => {
    console.log("[EXPLORE] Get explore content request received");

    const { category, sortBy } = req.query;

    // Using the imported storage instance

    try {
      // Get RSS documents as explore content
      const rssOptions: any = {
        category:
          category && category !== "all" ? (category as string) : undefined,
        sortBy: (sortBy as string) || undefined,
        search: undefined,
        feedId: undefined,
      };

      const rssDocuments = await storage.getUserRSSDocuments(rssOptions);

      // For now, we're using RSS documents as explore content
      // In the future, this could include system-curated content
      const exploreContent = rssDocuments.map((doc) => ({
        ...doc,
        isExploreContent: true,
        canSaveToLibrary: true,
      }));

      console.log(`[EXPLORE] Returning ${exploreContent.length} explore items`);
      res.json(exploreContent);
    } catch (error) {
      console.error("[EXPLORE] Error fetching explore content:", error);
      res.status(500).json({ error: "Failed to fetch explore content" });
    }
  });

  // Thumbnail API routes
  const { ObjectStorageService } = await import("./objectStorage");
  const { ThumbnailService } = await import("./thumbnailService");

  const objectStorageService = new ObjectStorageService();
  const thumbnailService = new ThumbnailService();

  // Serve thumbnail images
  app.get("/api/thumbnails/:filename", async (req: Request, res: Response) => {
    try {
      const filename = req.params.filename;
      const privateObjectDir = process.env.PRIVATE_OBJECT_DIR;
      if (!privateObjectDir) {
        return res.status(500).json({ error: "Object storage not configured" });
      }

      const thumbnailPath = `${privateObjectDir}/thumbnails/${filename}`;
      const file = await objectStorageService.getThumbnailFile(thumbnailPath);
      await objectStorageService.downloadObject(file, res);
    } catch (error) {
      console.error("Error serving thumbnail:", error);
      res.status(404).json({ error: "Thumbnail not found" });
    }
  });

  // Process thumbnail extraction for a document (async job)
  app.post(
    "/api/documents/:id/extract-thumbnail",
    async (req: Request, res: Response) => {
      try {
        const documentId = parseInt(req.params.id);
        const { sourceType, sourceData } = req.body;

        // Validate inputs
        if (!sourceType || !sourceData) {
          return res
            .status(400)
            .json({ error: "sourceType and sourceData are required" });
        }

        // Update document status to processing
        await storage.updateDocument(documentId, {
          thumbnailStatus: "processing",
        });

        // Start async thumbnail extraction
        setImmediate(async () => {
          try {
            const result = await thumbnailService.extractThumbnail(
              sourceType,
              sourceData,
            );

            // Update document with thumbnail info
            const updateData: any = {
              thumbnailStatus: result.status,
              originalImageUrl: result.originalImageUrl || null,
              dominantColor: result.dominantColor || null,
            };

            if (result.thumbnailPath && result.thumbnailUrl) {
              updateData.thumbnailPath = result.thumbnailPath;
              updateData.thumbnailUrl = result.thumbnailUrl;
            }

            await storage.updateDocument(documentId, updateData);
            console.log(
              `Thumbnail extraction completed for document ${documentId}: ${result.status}`,
            );
          } catch (error) {
            console.error(
              `Thumbnail extraction failed for document ${documentId}:`,
              error,
            );
            await storage.updateDocument(documentId, {
              thumbnailStatus: "failed",
            });
          }
        });

        res.json({ success: true, message: "Thumbnail extraction started" });
      } catch (error) {
        console.error("Error starting thumbnail extraction:", error);
        res.status(500).json({ error: "Failed to start thumbnail extraction" });
      }
    },
  );
}