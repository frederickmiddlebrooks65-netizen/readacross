  // === New RSS Feed/Subscription Management APIs ===

  // Get all RSS feeds (global Feed table)
  app.get("/api/admin/feeds", async (req: Request, res: Response) => {
    try {
      const {
        domain,
        status,
        minHealth,
        limit = "50",
        offset = "0",
      } = req.query;

      // Use new Feed model method
      const feeds = await storage.getAllRSSFeeds();

      // Apply filters
      let filteredFeeds = feeds;

      if (domain) {
        filteredFeeds = filteredFeeds.filter((feed) =>
          feed.canonicalUrl.includes(domain as string),
        );
      }

      if (status) {
        const enabled = status === "enabled";
        filteredFeeds = filteredFeeds.filter(
          (feed) => !feed.isBlocked === enabled,
        );
      }

      if (minHealth) {
        const healthThreshold = parseInt(minHealth as string);
        filteredFeeds = filteredFeeds.filter(
          (feed) => (feed.healthScore ?? 0) >= healthThreshold,
        );
      }

      // Apply pagination
      const limitNum = parseInt(limit as string);
      const offsetNum = parseInt(offset as string);
      const paginatedFeeds = filteredFeeds.slice(
        offsetNum,
        offsetNum + limitNum,
      );

      res.json(paginatedFeeds);
    } catch (error) {
      console.error("Error getting RSS feeds:", error);
      res.status(500).json({ message: "Failed to get RSS feeds" });
    }
  });

