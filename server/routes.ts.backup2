// **Phase 1: Anchor Generation - Core function to attach anchors to structured content**
export function attachAnchorsToStructuredContent(
  structuredBlocks: Array<any>,
  documentWithSentences: any,
): Array<any> {
  console.log(
    "[ANCHOR_GENERATION] Phase 1: Attaching anchors to",
    structuredBlocks.length,
    "structured blocks",
  );

  if (!documentWithSentences?.paragraphs) {
    console.warn(
      "[ANCHOR_GENERATION] No paragraphs found in document, skipping anchor generation",
    );
    return structuredBlocks;
  }

  // **CRITICAL FIX**: Extract sentences from the SAME structured blocks used for anchor generation
  // This ensures "Single Source of Truth" - same text extraction for both storage and anchoring
  console.log(
    '[ANCHOR_GENERATION] Phase 1: Using "Single Source of Truth" approach - extracting sentences from structured blocks',
  );

  const allSentences: Array<{ id: number; text: string; hash: string }> = [];
  let sentenceIndex = 0;

  // Get sentence IDs from stored paragraphs in order
  const storedSentenceIds: number[] = [];
  documentWithSentences.paragraphs.forEach((paragraph: any) => {
    if (paragraph.sentences) {
      paragraph.sentences.forEach((sentence: any) => {
        if (sentence.id) {
          storedSentenceIds.push(sentence.id);
        }
      });
    }
  });

  // Extract sentences from the same structured blocks being used for rendering
  structuredBlocks.forEach((block: any) => {
    if (block.type === "paragraph" && block.content) {
      const blockSentences = splitIntoSentences(block.content);
      blockSentences.forEach((sentence: string) => {
        if (sentenceIndex < storedSentenceIds.length) {
          const sentenceId = storedSentenceIds[sentenceIndex];
          const normalizedText = normalizeTextForMatching(sentence);
          const hash = generateSentenceHash(sentence);
          allSentences.push({
            id: sentenceId,
            text: normalizedText,
            hash: hash,
          });
          sentenceIndex++;
        }
      });
    }
  });

  console.log(
    `[ANCHOR_GENERATION] Phase 1: Found ${allSentences.length} sentences with IDs for matching`,
  );

  // Debug: Show sentence ID range we're working with for anchor generation
  if (allSentences.length > 0) {
    const sentenceIds = allSentences.map((s) => s.id).sort((a, b) => a - b);
    console.log(
      `[ANCHOR_GENERATION] Phase 1: Working with sentence ID range ${sentenceIds[0]}-${sentenceIds[sentenceIds.length - 1]} (${allSentences.length} sentences)`,
    );

    console.log("[ANCHOR_GENERATION] Phase 1: Sample sentence hashes:");
    allSentences.slice(0, 3).forEach((s) => {
      console.log(
        `  ID ${s.id}: "${s.text.substring(0, 40)}..." → ${s.hash.substring(0, 8)}...`,
      );
    });
  }

  // Process each structured block
  const blocksWithAnchors = structuredBlocks.map((block, index) => {
    const blockWithAnchor = { ...block };

    if (block.type === "paragraph" && block.content) {
      // Phase 1: Hash-based sentence matching for paragraph blocks
      const normalizedBlockContent = normalizeTextForMatching(block.content); // Use same normalization
      const blockSentences = splitIntoSentences(block.content); // Split original content first, then normalize

      if (blockSentences.length > 0) {
        const matchedSentenceIds: number[] = [];

        blockSentences.forEach((blockSentence) => {
          const blockSentenceHash = generateSentenceHash(blockSentence); // This will use normalizeTextForMatching internally

          // Find exact hash match
          const matchingSentence = allSentences.find(
            (s) => s.hash === blockSentenceHash,
          );
          if (matchingSentence) {
            matchedSentenceIds.push(matchingSentence.id);
            console.log(
              `[ANCHOR_GENERATION] ✅ Hash match found: "${blockSentence.substring(0, 40)}..." → sentence ID ${matchingSentence.id}`,
            );
          } else {
            console.log(
              `[ANCHOR_GENERATION] ❌ No hash match for: "${blockSentence.substring(0, 40)}..." (hash: ${blockSentenceHash.substring(0, 8)}...)`,
            );
          }
        });

        if (matchedSentenceIds.length > 0) {
          // Sort sentence IDs to ensure correct range
          matchedSentenceIds.sort((a, b) => a - b);

          blockWithAnchor.anchor = {
            sentenceStartId: matchedSentenceIds[0],
            sentenceEndId: matchedSentenceIds[matchedSentenceIds.length - 1],
            matchedSentenceCount: matchedSentenceIds.length,
            blockSentenceCount: blockSentences.length,
          };

          console.log(
            `[ANCHOR_GENERATION] Phase 1: Block ${index} (paragraph) anchored to sentences ${matchedSentenceIds[0]}-${matchedSentenceIds[matchedSentenceIds.length - 1]} (${matchedSentenceIds.length}/${blockSentences.length} matched)`,
          );
        } else {
          console.warn(
            `[ANCHOR_GENERATION] Phase 1: Block ${index} (paragraph) - no sentence matches found for content: "${block.content.substring(0, 60)}..."`,
          );
        }
      }
    } else {
      console.log(
        `[ANCHOR_GENERATION] Phase 1: Block ${index} (${block.type}) - skipping non-paragraph block`,
      );
    }

    return blockWithAnchor;
  });

  const anchoredCount = blocksWithAnchors.filter((b: any) => b.anchor).length;
  console.log(
    `[ANCHOR_GENERATION] Phase 1: ✅ Anchor generation complete. ${anchoredCount}/${structuredBlocks.length} blocks anchored`,
  );

  return blocksWithAnchors;
}

// **Phase 1: Helper functions for anchor generation**
function normalizeSentenceText(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^\w\s가-힣]/g, " ") // Remove punctuation, keep Korean characters
    .replace(/\s+/g, " ") // Normalize whitespace
    .trim();
}

// Use existing generateSentenceHash and splitIntoSentences functions defined above

// **Main function to generate structured content with anchors**
export async function generateStructuredContentWithAnchors(
  originalText: string,
  documentWithSentences: any, // DocumentWithSentenceHashes type
  sourceType: "html" | "text" | "pdf" = "text",
  source: string = "Upload",
  existingStructuredBlocks?: any[],
): Promise<StructuredBlockWithAnchor[]> {
  console.log(
    "[generateStructuredContentWithAnchors] Starting with source type:",
    sourceType,
  );
  console.log(
    "[generateStructuredContentWithAnchors] Document sentences:",
    documentWithSentences.paragraphs?.length || 0,
    "paragraphs",
  );

  // Use existing structured blocks from PDF extraction if available
  let structuredFromPdf = existingStructuredBlocks;

  if (!structuredFromPdf || structuredFromPdf.length === 0) {
    console.log(
      "[generateStructuredContentWithAnchors] No existing blocks, generating new ones",
    );
    // Generate structured content using existing function
    structuredFromPdf = await generateStructuredContent(
      originalText,
      sourceType,
      source,
    );
  }

  console.log(
    "[generateStructuredContentWithAnchors] Structured blocks to process:",
    structuredFromPdf.length,
  );

  // Apply anchor attachment using attachAnchors function
  const finalStructured = attachAnchors(
    documentWithSentences,
    structuredFromPdf,
  );

  console.log(
    "[generateStructuredContentWithAnchors] ✅ Final result:",
    finalStructured.length,
    "blocks with anchors",
  );

  return finalStructured;
}

function processDocumentText(text: string): {
  paragraphs: Array<{
    title: string | null;
    sentences: string[];
  }>;
} {
  const paragraphs = splitIntoParagraphs(text);

  const processedParagraphs = paragraphs.map((paragraph) => {
    const { title, content } = extractTitleFromParagraph(paragraph);
    const sentences = splitIntoSentences(content);

    return {
      title,
      sentences,
    };
  });

  return {
    paragraphs: processedParagraphs,
  };
}

// Unified Structured Content Pipeline - handles all input types (HTML, TEXT, PDF)
export async function generateStructuredContent(
  input: string,
  sourceType: "html" | "text" | "pdf" = "text",
  source?: string,
  withAnchors: boolean = false,
): Promise<
  Array<{
    type:
      | "heading"
      | "paragraph"
      | "image"
      | "table"
      | "list"
      | "code"
      | "quote"
      | "figure";
    order: number;
    page?: number;
    caption?: string;
    origin?: { page: number; bbox: [number, number, number, number] };
    src?: string;
    html?: string;
    imageSnapshot?: boolean;
    level?: number;
    content?: string;
    anchor?: { sentenceStartId: number; sentenceEndId: number };
  }>
> {
  const blocks: Array<{
    type:
      | "heading"
      | "paragraph"
      | "image"
      | "table"
      | "list"
      | "code"
      | "quote"
      | "figure";
    order: number;
    page?: number;
    caption?: string;
    origin?: { page: number; bbox: [number, number, number, number] };
    src?: string;
    html?: string;
    imageSnapshot?: boolean;
    level?: number;
    content?: string;
  }> = [];

  let blockOrder = 0;
  const seenContent = new Set<string>(); // Prevent duplicates

  // HTML Processing (for RSS, Guardian, etc.)
  if (sourceType === "html" && (input.includes("<") || input.includes(">"))) {
    try {
      const jsdom = await import("jsdom");
      const { JSDOM } = jsdom;
      const dom = new JSDOM(input);
      const document = dom.window.document;

      // 우선 중요 콘텐츠 요소들을 선택 (<p> 태그 우선)
      const paragraphElements = Array.from(document.querySelectorAll("p"));
      const otherElements = Array.from(
        document.querySelectorAll(
          "h1, h2, h3, h4, h5, h6, img, table, ul, ol, blockquote, pre, code",
        ),
      );

      // <p> 태그가 있으면 우선 사용, 없으면 div도 포함
      let contentElements: Element[] = [];

      if (paragraphElements.length > 2) {
        // <p> 태그가 충분히 있으면 <p> 태그만 사용
        console.log(
          "[generateStructuredContent] ✅ Using <p> elements for content:",
          paragraphElements.length,
        );
        contentElements = [...paragraphElements, ...otherElements];
      } else {
        // <p> 태그가 부족하면 div도 포함하되, 중첩 방지
        const divElements = Array.from(document.querySelectorAll("div")).filter(
          (div) => {
            const text = div.textContent?.trim() || "";
            return text.length > 100; // 충분한 길이의 div만 포함
          },
        );

        console.log(
          "[generateStructuredContent] ✅ Using mixed elements - p:",
          paragraphElements.length,
          "div:",
          divElements.length,
        );
        contentElements = [
          ...paragraphElements,
          ...divElements,
          ...otherElements,
        ];
      }

      // 문서 순서대로 정렬
      const topLevelElements = contentElements.sort((a, b) => {
        const posA = Array.from(document.querySelectorAll("*")).indexOf(a);
        const posB = Array.from(document.querySelectorAll("*")).indexOf(b);
        return posA - posB;
      });

      topLevelElements.forEach((element: any, index: number) => {
        const tagName = element.tagName.toLowerCase();
        blockOrder++;

        // Headings
        if (["h1", "h2", "h3", "h4", "h5", "h6"].includes(tagName)) {
          const text = element.textContent?.trim();
          if (text && text.length > 2) {
            const contentKey = `heading:${text.toLowerCase()}`;
            if (!seenContent.has(contentKey)) {
              seenContent.add(contentKey);
              blocks.push({
                type: "heading",
                level: parseInt(tagName.charAt(1)),
                order: blockOrder,
                content: text,
              });
            }
          }
        }

        // Images - enhanced extraction
        else if (tagName === "img") {
          const src = element.getAttribute("src");
          const alt = element.getAttribute("alt") || "";
          const title = element.getAttribute("title") || "";

          if (src && !src.startsWith("data:")) {
            const contentKey = `image:${src}`;
            if (!seenContent.has(contentKey)) {
              seenContent.add(contentKey);
              const caption = alt || title || "Image from article";
              blocks.push({
                type: "image",
                order: blockOrder,
                src: src.startsWith("http") ? src : null,
                caption: caption,
              });
            }
          }
        }

        // Tables
        else if (tagName === "table") {
          const html = element.outerHTML;
          const caption =
            element.querySelector("caption")?.textContent?.trim() ||
            "Table from article";
          const rows = element.querySelectorAll("tr");

          if (rows.length > 1) {
            blocks.push({
              type: "table",
              order: blockOrder,
              html: html,
              caption: caption,
            });
          }
        }

        // Lists
        else if (["ul", "ol"].includes(tagName)) {
          const text = element.textContent?.trim();
          if (text && text.length > 10) {
            blocks.push({
              type: "list",
              order: blockOrder,
              content: text,
            });
          }
        }

        // Quotes
        else if (tagName === "blockquote") {
          const text = element.textContent?.trim();
          if (text && text.length > 10) {
            blocks.push({
              type: "quote",
              order: blockOrder,
              content: text,
            });
          }
        }

        // Code blocks
        else if (["pre", "code"].includes(tagName)) {
          const text = element.textContent?.trim();
          if (text && text.length > 5) {
            blocks.push({
              type: "code",
              order: blockOrder,
              content: text,
            });
          }
        }

        // Paragraphs and divs - enhanced duplicate prevention
        else if (["p", "div"].includes(tagName)) {
          const text = element.textContent?.trim();
          if (text && text.length > 20) {
            // 강화된 중복 검사 - 전체 텍스트로 정확한 중복 감지
            const normalizedFullText = text
              .toLowerCase()
              .replace(/\s+/g, " ")
              .trim();

            // 1. 정확히 같은 내용인지 확인
            const isExactDuplicate = blocks.some((block) => {
              if (block.content) {
                const existingNormalized = block.content
                  .toLowerCase()
                  .replace(/\s+/g, " ")
                  .trim();
                return normalizedFullText === existingNormalized;
              }
              return false;
            });

            // 2. 포함 관계 중복 검사 - 더 엄격한 기준 적용
            const isSubstringDuplicate = blocks.some((block) => {
              if (block.content && block.content.length > 100) {
                const existingNormalized = block.content
                  .toLowerCase()
                  .replace(/\s+/g, " ")
                  .trim();
                // 80% 이상 겹치는 경우 중복으로 간주
                const overlapRatio =
                  Math.min(
                    normalizedFullText.length,
                    existingNormalized.length,
                  ) /
                  Math.max(
                    normalizedFullText.length,
                    existingNormalized.length,
                  );
                if (overlapRatio > 0.8) {
                  // 실제 문자열 포함 관계 확인
                  return (
                    existingNormalized.includes(normalizedFullText) ||
                    normalizedFullText.includes(existingNormalized)
                  );
                }
              }
              return false;
            });

            // 3. 중복이 아닌 경우에만 블록 추가
            if (!isExactDuplicate && !isSubstringDuplicate) {
              // Check if this is actually a heading (short text in div/p)
              if (text.length < 100 && text.match(/^[A-Z].*[^.!?]$/)) {
                blocks.push({
                  type: "heading",
                  order: blockOrder,
                  level: 3,
                  content: text,
                });
              } else {
                blocks.push({
                  type: "paragraph",
                  order: blockOrder,
                  content: text,
                });
              }
            } else {
              console.log(
                "[generateStructuredContent] 🚫 Skipping duplicate content:",
                text.substring(0, 100) + "...",
              );
            }
          }
        }
      });

      // Apply source-specific filtering rules
      if (source === "The Guardian" || source === "guardian") {
        // Remove Guardian-specific noise: related articles, ads, etc.
        return blocks.filter((block) => {
          if (block.type === "paragraph" && block.content) {
            return !block.content.match(
              /(Related articles|More on this story|Guardian readers|Subscribe to|Support the Guardian)/i,
            );
          }
          return true;
        });
      }
    } catch (error) {
      console.warn(
        "HTML parsing failed, falling back to text processing:",
        error,
      );
      // Fallback to text processing
      sourceType = "text";
      input = input
        .replace(/<[^>]*>/g, " ")
        .replace(/\s+/g, " ")
        .trim();
    }
  }

  // Text/PDF Processing (fallback and default)
  if (sourceType === "text" || sourceType === "pdf") {
    const paragraphs = splitIntoParagraphs(input);

    paragraphs.forEach((paragraph) => {
      blockOrder++;

      // Enhanced heading detection for academic papers (arXiv)
      if (paragraph.match(/^#{1,6}\s+/)) {
        const level = paragraph.match(/^(#{1,6})/)?.[1].length || 1;
        const content = paragraph.replace(/^#{1,6}\s+/, "").trim();
        blocks.push({
          type: "heading",
          order: blockOrder,
          level,
          content,
        });
      }
      // Academic section headings (Abstract, Introduction, etc.)
      else if (
        paragraph.match(
          /^(Abstract|Introduction|Conclusion|Discussion|Method|Results|Related Work|References|Bibliography|Acknowledgments)$/i,
        )
      ) {
        blocks.push({
          type: "heading",
          order: blockOrder,
          level: 2,
          content: paragraph,
        });
      }
      // Short potential headings
      else if (paragraph.length < 100 && paragraph.match(/^[A-Z].*[^.!?]$/)) {
        blocks.push({
          type: "heading",
          order: blockOrder,
          level: 3,
          content: paragraph,
        });
      }
      // Enhanced image detection
      else if (
        paragraph.match(
          /\[image\]|\[fig\]|\[figure\]|\[chart\]|\[diagram\]|Figure \d+|Fig\. \d+/i,
        )
      ) {
        blocks.push({
          type: "image",
          order: blockOrder,
          caption: "Figure - detailed extraction not yet implemented",
          content: paragraph,
          imageSnapshot: false,
        });
      }
      // Enhanced table detection
      else if (
        paragraph.match(/\[table\]|\[tab\]|\|\s*\w+\s*\||Table \d+|Tab\. \d+/i)
      ) {
        blocks.push({
          type: "table",
          order: blockOrder,
          caption: "Table - detailed extraction not yet implemented",
          html: `<div class="table-placeholder">${paragraph}</div>`,
          content: paragraph,
        });
      }
      // Lists
      else if (paragraph.match(/^\s*[-*+]\s+|\d+\.\s+/m)) {
        blocks.push({
          type: "list",
          order: blockOrder,
          content: paragraph,
        });
      }
      // Code blocks
      else if (
        paragraph.match(/```|`.*`/) ||
        (sourceType === "pdf" &&
          paragraph.match(/^[A-Za-z_][A-Za-z0-9_]*\s*\(/))
      ) {
        blocks.push({
          type: "code",
          order: blockOrder,
          content: paragraph,
        });
      }
      // Quotes
      else if (paragraph.match(/^>\s+|^"|"/)) {
        blocks.push({
          type: "quote",
          order: blockOrder,
          content: paragraph,
        });
      }
      // Regular paragraphs
      else if (paragraph.length > 10) {
        blocks.push({
          type: "paragraph",
          order: blockOrder,
          content: paragraph,
        });
      }
    });
  }

  // Global filtering: remove ads, navigation, footers
  return blocks.filter((block) => {
    if (block.type === "paragraph" && block.content) {
      const content = block.content.toLowerCase();
      // Filter common noise patterns
      if (
        content.match(
          /(subscribe|newsletter|follow us|share this|recommended|advertisement|sponsored|cookie policy|privacy policy|terms of service)/i,
        )
      ) {
        return false;
      }
    }
    return true;
  });
}

export async function registerRoutes(app: Express): Promise<Server> {
  // Basic test route to ensure the app is working
  app.get("/api/health", (req, res) => {
    res.json({ status: "ok", timestamp: new Date().toISOString() });
  });

  // Register all the routes from registerRoutesOld
  await registerRoutesOld(app);

  // Register library routes
  await addLibraryRoutes(app);

  // Create and return the HTTP server
  const server = createServer(app);
  return server;
}

// Temporary function while we debug the main routes
export async function registerRoutesOld(app: Express): Promise<void> {
  // Configure multer for file uploads
  const upload = multer({
    storage: multer.memoryStorage(),
    limits: {
      fileSize: 10 * 1024 * 1024, // 10MB max
    },
    fileFilter: (_req, file, cb) => {
      // Accept text, PDF and various DOCX mimetypes
      // Log the file mimetype for debugging
      console.log(
        `File upload mimetype: ${file.mimetype}, originalname: ${file.originalname}`,
      );

      if (
        file.mimetype === "text/plain" ||
        file.mimetype === "application/pdf" ||
        file.mimetype ===
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ||
        file.mimetype === "application/msword" ||
        // Handle docx that might come with different mimetypes
        file.originalname.endsWith(".docx") ||
        file.originalname.endsWith(".doc")
      ) {
        cb(null, true);
      } else {
        cb(
          new Error(
            `Unsupported file type: ${file.mimetype}. Only .txt, .pdf, and .docx files are allowed`,
          ),
        );
      }
    },
  });

  // Create document from text content
  app.post("/api/documents/create-from-text", async (req, res) => {
    try {
      const { title, content, sourceLanguage, targetLanguage } = req.body;

      if (!title || !content || !sourceLanguage || !targetLanguage) {
        return res.status(400).json({ message: "Missing required fields" });
      }

      // Split content by paragraph (preserving structure)
      const paragraphTexts = content
        .split(/\n\s*\n/)
        .map((p: string) => p.trim())
        .filter((p: string) => p.length > 0);
      const paragraphsData = [];
      for (const [pIndex, paragraphText] of paragraphTexts.entries()) {
        // Optionally extract a title, but for now we keep as null or use existing logic if needed
        // You can use extractTitleFromParagraph if you want titles per paragraph
        // const { title: paraTitle, content: paraContent } = extractTitleFromParagraph(paragraphText);
        // We'll skip titles for now for simplicity
        const paraTitle = null;
        const paraContent = paragraphText;
        // Split sentences within this paragraph using unified function
        const sentenceList = splitIntoSentences(paraContent);
        const sentencesData = [];
        for (let sIndex = 0; sIndex < sentenceList.length; sIndex++) {
          const sentence = sentenceList[sIndex];
          sentencesData.push({
            order: sIndex + 1,
            source: sentence,
          });
        }
        paragraphsData.push({
          order: pIndex + 1,
          title: paraTitle,
          sentences: sentencesData,
        });
      }

      // Create document with paragraphs and sentences first (mark as upload)
      const document = await storage.createDocumentWithParagraphs({
        title,
        sourceLanguage,
        targetLanguage,
        userId: null,
        fileType: "text",
        sourceType: "uploaded", // Explicitly set sourceType for proper filtering
        source: "Upload", // Mark as user upload
        paragraphs: paragraphsData,
      });

      // Get the created document with sentence IDs to generate anchored structured content
      const documentWithSentences = await storage.getDocumentWithParagraphs(
        document.id,
      );

      // Generate structured content with sentence ID anchors
      const structuredContent = await generateStructuredContentWithAnchors(
        content,
        documentWithSentences,
        "text",
        "Upload",
      );
      console.log(
        "[CREATE_FROM_TEXT] Structured content generated:",
        Array.isArray(structuredContent)
          ? structuredContent.length
          : typeof structuredContent,
      );

      // Update document with anchored structured content
      await storage.updateDocument(document.id, {
        structuredContent: JSON.stringify(structuredContent),
        structuredVersion: 2, // Version 2 includes anchor metadata
        contentSourceType: "text",
      });

      // Add thumbnail extraction job for uploaded text document
      // Set thumbnail status to failed for text documents (they'll use typography design)
      await storage.updateDocument(document.id, { thumbnailStatus: "failed" });
      console.log(
        `[THUMBNAIL] Set no_image status for text document ${document.id}`,
      );

      res.json({
        id: document.id,
        title: document.title,
        paragraphCount: paragraphsData.length,
        sourceLanguage: document.sourceLanguage,
        targetLanguage: document.targetLanguage,
      });
    } catch (error) {
      console.error("Error creating document from text:", error);
      res.status(500).json({ message: "Failed to create document" });
    }
  });

  // Get user documents with type filtering (uploads, saved, rss)
  app.get("/api/documents", async (req, res) => {
    try {
      const { category, sortBy, type, search, status } = req.query;
      const options = {
        category: typeof category === "string" ? category : undefined,
        sortBy: typeof sortBy === "string" ? sortBy : undefined,
        type: typeof type === "string" ? type : undefined,
        search: typeof search === "string" ? search : undefined,
        status:
          typeof status === "string" &&
          ["active", "archived", "all"].includes(status)
            ? (status as "active" | "archived" | "all")
            : "active",
      };

      let documents;
      switch (options.type) {
        case "uploads":
          documents = await storage.getUserUploadDocuments({
            status: options.status,
            search: options.search,
          });
          break;
        case "saved":
          documents = await storage.getUserSavedDocuments({
            status: options.status,
            search: options.search,
          });
          break;
        case "rss":
          const feedIdFilter = req.query.feedId
            ? parseInt(req.query.feedId as string)
            : undefined;
          documents = await storage.getUserRSSDocuments({
            category: options.category,
            sortBy: options.sortBy,
            search: options.search,
            feedId: feedIdFilter,
          });
          break;
        default:
          documents = await storage.getUserDocuments({
            category: options.category,
            sortBy: options.sortBy,
            search: options.search,
          });
          break;
      }
      const uniqueSources = Array.from(
        new Set(documents.map((d) => d.source || "unknown")),
      );
      console.log(
        `[DEBUG] Documents API - type: ${options.type}, feedId: ${req.query.feedId}, returned: ${documents.length} documents, sources: ${uniqueSources.join(", ")}`,
      );
      res.json(documents);
    } catch (error) {
      console.error("Error fetching user documents:", error);
      res.status(500).json({ message: "Failed to fetch documents" });
    }
  });

  // Archive a document
  app.post("/api/documents/:id/archive", async (req, res) => {
    try {
      const id = parseInt(req.params.id);
      console.log(`[ARCHIVE] Attempting to archive document ${id}`);

      // Check if document exists and is not archived
      const document = await storage.getDocument(id);
      if (!document) {
        console.log(`[ARCHIVE] Document ${id} not found`);
        return res.status(404).json({ message: "Document not found" });
      }

      console.log(
        `[ARCHIVE] Document ${id} found, isArchived: ${document.isArchived}`,
      );

      if (document.isArchived) {
        console.log(`[ARCHIVE] Document ${id} is already archived`);
        return res
          .status(400)
          .json({ message: "Document is already archived" });
      }

      const updatedDocument = await storage.archiveDocument(id);
      if (!updatedDocument) {
        console.log(`[ARCHIVE] Failed to archive document ${id}`);
        return res.status(500).json({ message: "Failed to archive document" });
      }

      console.log(
        `[ARCHIVE] Document ${id} archived successfully, isArchived: ${updatedDocument.isArchived}`,
      );
      res.json({
        message: "Document archived successfully",
        document: updatedDocument,
      });
    } catch (error) {
      console.error("Error archiving document:", error);
      res.status(500).json({ message: "Failed to archive document" });
    }
  });

  // Restore an archived document
  app.post("/api/documents/:id/restore", async (req, res) => {
    try {
      const id = parseInt(req.params.id);

      // Check if document exists and is archived
      const document = await storage.getDocument(id);
      if (!document) {
        return res.status(404).json({ message: "Document not found" });
      }

      if (!document.isArchived) {
        return res.status(400).json({ message: "Document is not archived" });
      }

      const updatedDocument = await storage.restoreDocument(id);
      if (!updatedDocument) {
        return res.status(500).json({ message: "Failed to restore document" });
      }

      res.json({
        message: "Document restored successfully",
        document: updatedDocument,
      });
    } catch (error) {
      console.error("Error restoring document:", error);
      res.status(500).json({ message: "Failed to restore document" });
    }
  });

  // Enhanced delete endpoint - only allows deletion of archived documents
  app.delete("/api/documents/:id", async (req, res) => {
    try {
      const id = parseInt(req.params.id);

      // Check if document exists and is archived
      const document = await storage.getDocument(id);
      if (!document) {
        return res.status(404).json({ message: "Document not found" });
      }

      if (!document.isArchived) {
        return res.status(400).json({
          message:
            "Only archived documents can be deleted. Please archive the document first.",
        });
      }

      const deleted = await storage.deleteDocument(id);
      if (!deleted) {
        return res.status(500).json({ message: "Failed to delete document" });
      }

      res.json({ message: "Document deleted successfully" });
    } catch (error) {
      console.error("Error deleting document:", error);
      res.status(500).json({ message: "Failed to delete document" });
    }
  });

  // Add public document to user's library
  app.post("/api/documents/:id/add-to-library", async (req, res) => {
    try {
      const documentId = parseInt(req.params.id);

      // Get the public document
      const publicDocument = await storage.getDocument(documentId);
      if (!publicDocument || !publicDocument.isPublic) {
        return res.status(404).json({ message: "Public document not found" });
      }

      // Check if user already has this document in their library
      const userDocuments = await storage.getUserDocuments();
      const existingDocument = userDocuments.find(
        (doc) => doc.title === publicDocument.title,
      );
      if (existingDocument) {
        return res.status(409).json({
          message: "이미 서재에 있는 문서입니다",
          existingId: existingDocument.id,
        });
      }

      // Get the full document with paragraphs
      const fullDocument = await storage.getDocumentWithParagraphs(documentId);
      if (!fullDocument) {
        return res.status(404).json({ message: "Document content not found" });
      }

      // Create a copy for the user (mark as saved from explore)
      const userDocument = await storage.createDocumentWithParagraphs({
        title: publicDocument.title,
        sourceLanguage: publicDocument.sourceLanguage,
        targetLanguage: publicDocument.targetLanguage,
        userId: null, // For now, no user authentication
        fileType: publicDocument.fileType || "text",
        author: publicDocument.author || undefined,
        source: "Saved", // Mark as saved from explore
        category: publicDocument.category || undefined,
        difficulty: publicDocument.difficulty || undefined,
        tags: publicDocument.tags || undefined,
        originalUrl: publicDocument.originalUrl || undefined,
        licenseType: publicDocument.licenseType || undefined,
        isPublic: false, // User's copy is private
        paragraphs: fullDocument.paragraphs.map((p) => ({
          order: p.order,
          title: p.title,
          sentences: p.sentences.map((s) => ({
            order: s.order,
            source: s.source,
            target: s.target || undefined,
          })),
        })),
      });

      res.json({
        id: userDocument.id,
        title: userDocument.title,
        message: "Document added to your library",
      });
    } catch (error) {
      console.error("Error adding document to library:", error);
      res.status(500).json({ message: "Failed to add document to library" });
    }
  });

  // Get a document with paragraphs and sentences
  app.get("/api/documents/:id", async (req, res) => {
    try {
      const id = parseInt(req.params.id);
      const document = await storage.getDocumentWithParagraphs(id);
      if (!document) {
        return res.status(404).json({ message: "Document not found" });
      }

      // Update document activity when viewing (for non-public documents)
      if (!document.isPublic) {
        try {
          await storage.updateDocumentActivity(id);
        } catch (activityError) {
          console.warn("Failed to update document activity:", activityError);
          // Don't fail the request if activity update fails
        }
      }

      // Parse structured content if available, or generate it for legacy documents
      let structuredBlocks: any[] = [];
      if (document.structuredContent) {
        try {
          console.log(
            `[Retrieve] Getting structured content for document ${id}:`,
            {
              type: typeof document.structuredContent,
              isArray: Array.isArray(document.structuredContent),
            },
          );

          // Handle both string (legacy) and object (new) formats
          if (typeof document.structuredContent === "string") {
            structuredBlocks = JSON.parse(document.structuredContent);
          } else {
            structuredBlocks = document.structuredContent as any;
          }
        } catch (error) {
          console.warn("Failed to parse structured content:", error);
          structuredBlocks = [];
        }
      } else {
        // Generate structured content for legacy documents
        try {
          console.log(
            `[Legacy Document] Generating structured content for document ${id}`,
          );

          // Reconstruct original content from paragraphs
          const originalContent = document.paragraphs
            .sort((a, b) => a.order - b.order)
            .map((p) => {
              const sentences = p.sentences
                .sort((a, b) => a.order - b.order)
                .map((s) => s.source)
                .join(" ");
              return p.title ? `${p.title}\n\n${sentences}` : sentences;
            })
            .join("\n\n");

          if (originalContent.trim().length > 0) {
            // Determine content type based on document source and fileType
            let contentType: "html" | "text" | "pdf" = "text";
            if (document.fileType === "pdf") {
              contentType = "pdf";
            } else if (
              document.source === "RSS" ||
              document.source?.includes("Guardian") ||
              originalContent.includes("<")
            ) {
              contentType = "html";
            }

            // Skip structured content generation for arXiv documents as they already have structured paragraphs
            const sourceName = document.source || "Legacy Document";
            if (document.source !== "arXiv") {
              // Generate basic structured content first
              const basicBlocks = await generateStructuredContent(
                originalContent,
                contentType,
                sourceName,
              );

              // Then add anchors if we have paragraphs data
              if (basicBlocks.length > 0) {
                structuredBlocks = await generateStructuredContentWithAnchors(
                  originalContent,
                  document,
                  contentType,
                  sourceName,
                  basicBlocks,
                );
              }
            }

            // Save generated structured content to database for future use
            if (structuredBlocks.length > 0) {
              await storage.updateDocument(id, {
                structuredContent: JSON.stringify(structuredBlocks),
                structuredVersion: 1,
                contentSourceType: contentType,
              });
              console.log(
                `[Legacy Document] Saved structured content for document ${id} (${structuredBlocks.length} blocks)`,
              );
            }
          }
        } catch (error) {
          console.warn(
            `[Legacy Document] Failed to generate structured content for document ${id}:`,
            error,
          );
          structuredBlocks = [];
        }
      }

      // Create sentencesById map to support anchor-based rendering
      const sentencesById: Record<number, any> = {};
      if (document.paragraphs) {
        for (const paragraph of document.paragraphs) {
          if (paragraph.sentences) {
            for (const sentence of paragraph.sentences) {
              sentencesById[sentence.id] = {
                id: sentence.id,
                source: sentence.source,
                target: sentence.target,
                paragraphId: paragraph.id,
                status: sentence.status,
                practiceCount: sentence.practiceCount,
                isScrapped: sentence.isScrapped,
                note: sentence.note,
              };
            }
          }
        }
      }

      res.json({
        ...document,
        structuredContent: structuredBlocks, // Add structured blocks to response with correct field name
        sentencesById, // Add sentences map for direct ID lookup
      });
    } catch (error) {
      res.status(500).json({ message: "Failed to fetch document" });
    }
  });

  // Upload a document (without translation)
  app.post(
    "/api/documents/upload",
    (req, res, next) => {
      console.log("Upload request headers:", {
        contentType: req.headers["content-type"],
        contentLength: req.headers["content-length"],
      });
      // Continue with multer
      upload.single("file")(req, res, (err) => {
        if (err) {
          console.error("Multer error:", err.message);
          return res.status(400).json({ message: err.message });
        }
        next();
      });
    },
    async (req, res) => {
      try {
        console.log("Upload request processed:", {
          body: Object.keys(req.body),
          file: req.file
            ? {
                originalname: req.file.originalname,
                mimetype: req.file.mimetype,
                size: req.file.size,
                fieldname: req.file.fieldname,
              }
            : "No file",
        });

        if (!req.file) {
          return res.status(400).json({ message: "No file uploaded" });
        }

        const { title, sourceLanguage, targetLanguage } = req.body;

        if (!title || !sourceLanguage || !targetLanguage) {
          return res.status(400).json({ message: "Missing required fields" });
        }

        // Process the document content based on file type
        console.log(
          `Processing file: ${req.file.originalname} (${req.file.mimetype})`,
        );
        let documentText = "";

        if (req.file.mimetype === "text/plain") {
          // Handle text files
          documentText = req.file.buffer.toString("utf-8");
          console.log(
            `TXT file processed, content length: ${documentText.length}`,
          );
        } else if (req.file.mimetype === "application/pdf") {
          // Handle PDF files
          try {
            console.log("Starting PDF extraction...");
            documentText = await parsePDF(req.file.buffer);
            console.log(
              `PDF file processed, content length: ${documentText.length}`,
            );
          } catch (error) {
            console.error("PDF parsing error:", error);
            return res
              .status(400)
              .json({ message: "Failed to parse PDF file" });
          }
        } else if (
          req.file.mimetype ===
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ||
          req.file.originalname.toLowerCase().endsWith(".docx") ||
          req.file.originalname.toLowerCase().endsWith(".doc")
        ) {
          // Handle DOCX files
          try {
            console.log("Starting DOCX extraction...");
            const result = await mammoth.extractRawText({
              buffer: req.file.buffer,
            });
            documentText = result.value;
            console.log(
              `DOCX file processed, content length: ${documentText.length}`,
            );
          } catch (error) {
            console.error("DOCX parsing error:", error);
            return res
              .status(400)
              .json({ message: "Failed to parse DOCX file" });
          }
        } else {
          console.error(`Unsupported file format: ${req.file.mimetype}`);
          return res
            .status(400)
            .json({ message: `Unsupported file format: ${req.file.mimetype}` });
        }

        // Use the same improved text processing logic as text paste
        // Use paragraph-based splitting for consistent rendering
        const paragraphRegex = /\n\s*\n/;

        // Split into paragraphs, then sentences per paragraph using unified function
        const paragraphsArr = documentText
          .split(paragraphRegex)
          .map((p) => p.trim())
          .filter((p) => p.length > 0)
          .map((paragraph) => {
            const sentences = splitIntoSentences(paragraph); // Use unified function
            return sentences;
          });

        // Prepare paragraphs for storage - Phase 1: Use structured blocks for PDF files
        let paragraphs = [];

        // Determine file type first
        let fileType = "txt";
        if (req.file.mimetype === "application/pdf") {
          fileType = "pdf";
        } else if (
          req.file.mimetype ===
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ||
          req.file.originalname.toLowerCase().endsWith(".docx")
        ) {
          fileType = "docx";
        }

        // Only process text-based paragraphs if not PDF (PDF will use structured extraction)
        if (fileType !== "pdf") {
          for (let pIndex = 0; pIndex < paragraphsArr.length; pIndex++) {
            const sentences = paragraphsArr[pIndex];
            const sentencesData = [];
            for (let sIndex = 0; sIndex < sentences.length; sIndex++) {
              const sentence = sentences[sIndex].trim();
              if (sentence) {
                sentencesData.push({
                  order: sIndex + 1,
                  source: sentence,
                });
              }
            }
            if (sentencesData.length > 0) {
              paragraphs.push({
                order: pIndex + 1,
                title: null,
                sentences: sentencesData,
              });
            }
          }
        }

        // File type already determined above

        // Generate structured content blocks FIRST for Phase 1 consistency
        let structuredContent: Array<{
          type:
            | "heading"
            | "paragraph"
            | "image"
            | "table"
            | "list"
            | "code"
            | "quote"
            | "figure";
          order: number;
          page?: number;
          caption?: string;
          origin?: { page: number; bbox: [number, number, number, number] };
          src?: string;
          html?: string;
          imageSnapshot?: boolean;
          level?: number;
          content?: string;
        }> = [];

        if (fileType === "pdf") {
          try {
            // Use the new academic PDF extractor for PDF files
            console.log(
              "[ANCHOR_GENERATION] Phase 1: Using structured extraction for sentence consistency",
            );
            const { extractPdfAcademic } = await import("./pdfUtils.js");
            structuredContent = await extractPdfAcademic(req.file.buffer);
            console.log(
              `[ANCHOR_GENERATION] Phase 1: Extracted ${structuredContent.length} structured blocks`,
            );

            // If academic extraction fails or returns insufficient content, use fallback
            if (structuredContent.length === 0) {
              console.log(
                "[ANCHOR_GENERATION] Phase 1: No structured blocks, using text fallback",
              );
              structuredContent = await generateStructuredContent(
                documentText,
                "pdf",
                "Upload",
              );
            }
          } catch (error: any) {
            console.warn(
              `[ANCHOR_GENERATION] Phase 1: Structured extraction failed: ${error.message}`,
            );
            // Fallback to the basic structured content generator
            structuredContent = await generateStructuredContent(
              documentText,
              "pdf",
              "Upload",
            );
          }
        } else {
          const contentSourceType = "text";
          structuredContent = await generateStructuredContent(
            documentText,
            contentSourceType,
            "Upload",
          );
        }

        // Phase 1: Extract sentences from structured blocks for PDF files to ensure consistency
        if (fileType === "pdf" && structuredContent.length > 0) {
          console.log(
            "[ANCHOR_GENERATION] Phase 1: Extracting sentences from structured blocks for consistency",
          );

          // Extract sentences from paragraph blocks only
          let paragraphIndex = 0;
          for (const block of structuredContent) {
            if (block.type === "paragraph" && block.content) {
              const sentences = splitIntoSentences(block.content);
              if (sentences.length > 0) {
                const sentencesData = sentences.map((sentence, sIndex) => ({
                  order: sIndex + 1,
                  source: sentence,
                }));

                paragraphs.push({
                  title: null,
                  order: paragraphIndex + 1,
                  sentences: sentencesData,
                });
                paragraphIndex++;
              }
            }
          }
          console.log(
            `[ANCHOR_GENERATION] Phase 1: Extracted ${paragraphs.length} paragraphs from ${structuredContent.filter((b) => b.type === "paragraph").length} paragraph blocks`,
          );
        }

        // Create the document in the database (mark as upload)
        const document = await storage.createDocumentWithParagraphs({
          title,
          sourceLanguage,
          targetLanguage,
          fileType,
          source: "Upload", // Mark as user upload
          paragraphs,
        });

        // Get the created document with sentence IDs for anchor generation
        const documentWithSentences = await storage.getDocumentWithParagraphs(
          document.id,
        );

        // Phase 1: Generate anchored structured content for structured documents
        let finalStructuredContent = structuredContent;
        console.log(
          "[ANCHOR_GENERATION] Phase 1: Debugging anchor generation conditions:",
          {
            fileType,
            documentId: document.id,
            structuredContentLength: structuredContent.length,
            documentWithSentences: !!documentWithSentences,
            paragraphsCount: documentWithSentences?.paragraphs?.length || 0,
            sentencesCount:
              documentWithSentences?.paragraphs?.reduce(
                (total: number, p: any) => total + (p.sentences?.length || 0),
                0,
              ) || 0,
          },
        );

        // Debug: Show sentence ID range for this document
        if (
          documentWithSentences &&
          documentWithSentences.paragraphs &&
          documentWithSentences.paragraphs.length > 0
        ) {
          const allSentences = documentWithSentences.paragraphs.flatMap(
            (p) => p.sentences,
          );
          const sentenceIds = allSentences
            .map((s) => s.id)
            .sort((a, b) => a - b);
          console.log(
            `[ANCHOR_GENERATION] Phase 1: Document ${document.id} sentence ID range: ${sentenceIds[0]}-${sentenceIds[sentenceIds.length - 1]} (${sentenceIds.length} total)`,
          );
        }

        if (
          fileType === "pdf" &&
          structuredContent.length > 0 &&
          documentWithSentences &&
          documentWithSentences.paragraphs &&
          documentWithSentences.paragraphs.length > 0
        ) {
          console.log(
            "[ANCHOR_GENERATION] Phase 1: Starting anchor attachment for PDF document",
          );
          finalStructuredContent = attachAnchorsToStructuredContent(
            structuredContent,
            documentWithSentences,
          );
          console.log(
            `[ANCHOR_GENERATION] Phase 1: Completed. ${finalStructuredContent.filter((b: any) => b.anchor).length}/${finalStructuredContent.length} blocks anchored`,
          );
        } else {
          console.warn(
            "[ANCHOR_GENERATION] Phase 1: Skipping anchor generation due to unmet conditions:",
            {
              fileType,
              structuredContentLength: structuredContent.length,
              hasDocumentWithSentences: !!documentWithSentences,
              hasParagraphs: !!documentWithSentences?.paragraphs?.length,
            },
          );
        }

        // Update document with structured content and metadata
        await storage.updateDocument(document.id, {
          structuredContent: JSON.stringify(finalStructuredContent),
          structuredVersion: fileType === "pdf" ? 2 : 1,
          contentSourceType: fileType === "pdf" ? "pdf" : "text",
        });

        // Initialize progress to 0 to indicate no translation has been done
        await storage.updateDocumentProgress(document.id, 0);

        // Add thumbnail extraction job for uploaded file
        // Set thumbnail status to failed for text documents (they'll use typography design)
        await storage.updateDocument(document.id, {
          thumbnailStatus: "failed",
        });
        console.log(
          `[THUMBNAIL] Set no_image status for text document ${document.id}`,
        );

        // Return the document with paragraphs and sentences immediately
        // without waiting for translation
        const fullDocument = await storage.getDocumentWithParagraphs(
          document.id,
        );

        res.status(201).json(fullDocument || document);
      } catch (error) {
        console.error("Upload error:", error);
        res.status(500).json({ message: "Failed to process document" });
      }
    },
  );

  // PDF Import API - Step-by-step implementation as requested
  app.post(
    "/api/import/pdf",
    upload.single("file"),
    async (req: Request, res: Response) => {
      try {
        if (!req.file) {
          return res.status(400).json({ message: "No PDF file uploaded" });
        }

        if (req.file.mimetype !== "application/pdf") {
          return res
            .status(400)
            .json({ message: "Only PDF files are supported" });
        }

        const {
          title,
          sourceLanguage = "en",
          targetLanguage = "ko",
        } = req.body;

        if (!title) {
          return res.status(400).json({ message: "Title is required" });
        }

        console.log(
          `[PDF Import] Processing PDF: ${req.file.originalname}, size: ${req.file.size} bytes`,
        );

        // Extract text from PDF
        let documentText = "";
        try {
          documentText = await parsePDF(req.file.buffer);
          console.log(
            `[PDF Import] Text extracted, length: ${documentText.length} characters`,
          );
        } catch (error) {
          console.error("[PDF Import] PDF parsing error:", error);
          return res
            .status(400)
            .json({ message: "Failed to extract text from PDF" });
        }

        if (!documentText.trim()) {
          return res
            .status(400)
            .json({ message: "No text content found in PDF" });
        }

        // Generate structured content using academic PDF extractor for Phase 1 Structured View
        let structuredContent: Array<{
          type:
            | "heading"
            | "paragraph"
            | "image"
            | "table"
            | "list"
            | "code"
            | "quote"
            | "figure";
          order: number;
          page?: number;
          caption?: string;
          origin?: { page: number; bbox: [number, number, number, number] };
          src?: string;
          html?: string;
          imageSnapshot?: boolean;
          level?: number;
          content?: string;
        }> = [];

        try {
          // Use the new academic PDF extractor
          const { extractPdfAcademic } = await import("./pdfUtils.js");
          structuredContent = await extractPdfAcademic(req.file.buffer);
          console.log(
            `[PDF Import] Academic extraction: ${structuredContent.length} structured blocks`,
          );
        } catch (error: any) {
          console.warn(
            `[PDF Import] Academic extraction failed, using fallback: ${error.message}`,
          );
          // Fallback to the basic structured content generator
          structuredContent = await generateStructuredContent(
            documentText,
            "pdf",
            "PDF Import",
          );
        }

        // Process text into paragraphs and sentences (using existing logic)
        const paragraphsArr = documentText
          .split(/\n\s*\n/)
          .map((p) => p.trim())
          .filter((p) => p.length > 0)
          .map((paragraph) => {
            const sentences = paragraph
              .split(/(?<=[.!?]["')\]]?)\s+/g)
              .map((s) => s.trim())
              .filter(Boolean);
            return sentences;
          });

        // Prepare paragraphs for storage
        const paragraphs = [];
        for (let pIndex = 0; pIndex < paragraphsArr.length; pIndex++) {
          const sentences = paragraphsArr[pIndex];
          const sentencesData = [];
          for (let sIndex = 0; sIndex < sentences.length; sIndex++) {
            const sentence = sentences[sIndex].trim();
            if (sentence) {
              sentencesData.push({
                order: sIndex + 1,
                source: sentence,
              });
            }
          }
          if (sentencesData.length > 0) {
            paragraphs.push({
              order: pIndex + 1,
              title: null,
              sentences: sentencesData,
            });
          }
        }

        // Create document in database
        const document = await storage.createDocumentWithParagraphs({
          title,
          sourceLanguage,
          targetLanguage,
          fileType: "pdf",
          source: "PDF Import",
          category: "Educational",
          paragraphs,
        });

        // Get the created document with sentence IDs for anchor generation
        const documentWithSentences = await storage.getDocumentWithParagraphs(
          document.id,
        );

        // Generate anchored structured content for structured documents
        let finalStructuredContent = structuredContent;
        if (structuredContent.length > 0) {
          try {
            finalStructuredContent = await generateStructuredContentWithAnchors(
              documentText,
              documentWithSentences,
              "pdf",
              "PDF Import",
              structuredContent,
            );
          } catch (error) {
            console.warn(
              `[PDF Import] Failed to generate anchored content, using basic structured content: ${error}`,
            );
            finalStructuredContent = structuredContent;
          }
        }

        // Update document with structured content and metadata
        await storage.updateDocument(document.id, {
          structuredContent: JSON.stringify(finalStructuredContent),
          structuredVersion: 2,
          contentSourceType: "pdf",
        });

        // Initialize progress and thumbnail status
        await storage.updateDocumentProgress(document.id, 0);
        await storage.updateDocument(document.id, {
          thumbnailStatus: "failed",
        });

        console.log(
          `[PDF Import] Document created successfully: ID ${document.id}`,
        );

        res.status(201).json({
          id: document.id,
          title: document.title,
          paragraphCount: paragraphs.length,
          sourceLanguage: document.sourceLanguage,
          targetLanguage: document.targetLanguage,
          structuredBlocks: finalStructuredContent.length,
          message: "PDF imported successfully with structured content",
        });
      } catch (error) {
        console.error("[PDF Import] Error:", error);
        res.status(500).json({ message: "Failed to import PDF" });
      }
    },
  );

  // Download a document
  app.get("/api/documents/:id/download", async (req, res) => {
    try {
      const id = parseInt(req.params.id);
      const document = await storage.getDocumentWithParagraphs(id);

      if (!document) {
        return res.status(404).json({ message: "Document not found" });
      }

      // Format the document as text
      let content = `# ${document.title}\n\n`;

      for (const paragraph of document.paragraphs) {
        if (paragraph.title) {
          content += `## ${paragraph.title}\n\n`;
        }

        for (const sentence of paragraph.sentences) {
          // Include both source and translation
          content += `${sentence.source}\n`;
          if (sentence.target) {
            content += `[Translation] ${sentence.target}\n`;
          }
          content += "\n";
        }

        content += "\n";
      }

      res.setHeader("Content-Type", "text/plain");
      res.setHeader(
        "Content-Disposition",
        `attachment; filename=${document.title.replace(/\s+/g, "_")}.txt`,
      );
      res.send(content);
    } catch (error) {
      res.status(500).json({ message: "Failed to download document" });
    }
  });

  // Helper function to get or create document-based notebook
  async function getOrCreateDocumentNotebook(
    documentId: number,
    userId: number = 1,
  ) {
    try {
      // First check if a system notebook for this document already exists
      const existingNotebook =
        await storage.getNotebookByDocumentId(documentId);
      if (existingNotebook) {
        return existingNotebook;
      }

      // Get document details
      const document = await storage.getDocument(documentId);
      if (!document) {
        throw new Error("Document not found");
      }

      // Create auto-generated notebook
      const notebookData = {
        title: `📘 ${document.title}`,
        description: null,
        tags: null,
        type: "system",
        documentId: documentId,
        isPublic: false,
        userId: userId,
      };

      const newNotebook = await storage.createNotebook(notebookData);

      // Add all scrapped sentences from this document to the notebook
      const documentWithParagraphs =
        await storage.getDocumentWithParagraphs(documentId);
      if (documentWithParagraphs) {
        for (const paragraph of documentWithParagraphs.paragraphs) {
          for (const sentence of paragraph.sentences) {
            if (sentence.isScrapped || sentence.note) {
              try {
                await storage.addSentenceToNotebook(
                  newNotebook.id,
                  sentence.id,
                );
              } catch (error) {
                // Ignore duplicate relationship errors
                console.log(
                  `Sentence ${sentence.id} already in notebook ${newNotebook.id}`,
                );
              }
            }
          }
        }
      }

      return newNotebook;
    } catch (error) {
      console.error("Error creating document notebook:", error);
      throw error;
    }
  }

  // Update a sentence (note, scrapped status)
  app.patch("/api/sentences/:id", async (req, res) => {
    try {
      const id = parseInt(req.params.id);
      const validatedData = updateSentenceSchema.parse(req.body);

      // Phase 3: Add anchor-based consistency validation for translation updates
      if (validatedData.target) {
        const sentence = await storage.getSentence(id);
        if (sentence) {
          const paragraph = await storage.getParagraph(sentence.paragraphId);
          if (paragraph) {
            const document = await storage.getDocument(paragraph.documentId);
            if (
              document &&
              document.structuredContent &&
              document.structuredVersion === 2
            ) {
              try {
                const structuredBlocks =
                  typeof document.structuredContent === "string"
                    ? JSON.parse(document.structuredContent)
                    : document.structuredContent;
                const containingBlock = structuredBlocks.find(
                  (block: any) =>
                    block.anchor &&
                    id >= block.anchor.sentenceStartId &&
                    id <= block.anchor.sentenceEndId,
                );

                if (containingBlock) {
                  console.log(
                    "[ANCHOR_CONSISTENCY] Server: Translation update validated:",
                    {
                      documentId: document.id,
                      sentenceId: id,
                      blockOrder: containingBlock.order,
                      anchorRange: [
                        containingBlock.anchor.sentenceStartId,
                        containingBlock.anchor.sentenceEndId,
                      ],
                      translationLength: validatedData.target.length,
                    },
                  );
                } else {
                  console.warn(
                    "[ANCHOR_CONSISTENCY] Server: Translation update outside anchor ranges:",
                    {
                      documentId: document.id,
                      sentenceId: id,
                      availableAnchors: structuredBlocks
                        .filter((b: any) => b.anchor)
                        .map((b: any) => ({
                          order: b.order,
                          range: [
                            b.anchor.sentenceStartId,
                            b.anchor.sentenceEndId,
                          ],
                        })),
                    },
                  );
                }
              } catch (error) {
                console.warn(
                  "[ANCHOR_CONSISTENCY] Server: Failed to parse structured content for consistency check:",
                  error,
                );
              }
            }
          }
        }
      }

      const updatedSentence = await storage.updateSentence(id, validatedData);
      if (!updatedSentence) {
        return res.status(404).json({ message: "Sentence not found" });
      }

      // If a note was added, automatically create/use document-based notebook
      if (validatedData.note && validatedData.note.trim()) {
        try {
          // Get paragraph and document info
          const paragraph = await storage.getParagraph(
            updatedSentence.paragraphId,
          );
          if (paragraph && paragraph.documentId) {
            const documentNotebook = await getOrCreateDocumentNotebook(
              paragraph.documentId,
            );

            // Add sentence to document notebook if not already present
            const isAlreadyInNotebook = await storage.isSentenceInNotebook(
              id,
              documentNotebook.id,
            );
            if (!isAlreadyInNotebook) {
              await storage.addSentenceToNotebook(
                documentNotebook.id,
                id,
                validatedData.note,
              );
            } else {
              // Update the personal note in the notebook
              await storage.updateNotebookSentenceNote(
                documentNotebook.id,
                id,
                validatedData.note,
              );
            }
          }
        } catch (error) {
          console.error("Error auto-adding to document notebook:", error);
          // Don't fail the sentence update if notebook creation fails
        }
      }

      res.json(updatedSentence);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res
          .status(400)
          .json({ message: "Invalid data", errors: error.errors });
      }
      res.status(500).json({ message: "Failed to update sentence" });
    }
  });

  // Translate a text
  app.post("/api/translate", async (req, res) => {
    try {
      const { text, sourceLanguage, targetLanguage } = req.body;

      if (!text || !sourceLanguage || !targetLanguage) {
        return res.status(400).json({ message: "Missing required fields" });
      }

      const translation = await translateText(
        text,
        sourceLanguage,
        targetLanguage,
      );
      res.json({ translation });
    } catch (error) {
      res.status(500).json({ message: "Translation failed" });
    }
  });

  // Batch translate sentences
  app.post("/api/translate/batch", async (req, res) => {
    try {
      const { sentences, sourceLanguage, targetLanguage } = req.body;

      if (
        !sentences ||
        !Array.isArray(sentences) ||
        !sourceLanguage ||
        !targetLanguage
      ) {
        return res.status(400).json({ message: "Invalid request format" });
      }

      // Translate each sentence
      const translations = await Promise.all(
        sentences.map((text) =>
          translateText(text, sourceLanguage, targetLanguage),
        ),
      );

      res.json({ translations });
    } catch (error) {
      res.status(500).json({ message: "Batch translation failed" });
    }
  });

  // Translate a single sentence by ID
  app.post("/api/sentences/:id/translate", async (req, res) => {
    try {
      const id = parseInt(req.params.id);

      // Get the sentence
      const sentence = await storage.getSentence(id);
      if (!sentence) {
        return res.status(404).json({ message: "Sentence not found" });
      }

      // Get the paragraph to find the document ID
      const paragraph = await storage.getParagraph(sentence.paragraphId);
      if (!paragraph) {
        return res
          .status(404)
          .json({ message: "Associated paragraph not found" });
      }

      // Get the document
      const document = await storage.getDocument(paragraph.documentId);
      if (!document) {
        return res
          .status(404)
          .json({ message: "Associated document not found" });
      }

      const sourceLanguage = document.sourceLanguage;
      const targetLanguage = document.targetLanguage;

      // Check if already translated
      if (sentence.target) {
        return res.json(sentence);
      }

      // Translate the sentence
      const translation = await translateText(
        sentence.source,
        sourceLanguage,
        targetLanguage,
      );

      // Update the sentence with the translation
      const updatedSentence = await storage.updateSentence(id, {
        target: translation,
      });

      res.json(updatedSentence);
    } catch (error) {
      console.error("Single sentence translation error:", error);
      res.status(500).json({ message: "Failed to translate sentence" });
    }
  });

  // Start translation for entire document
  app.post("/api/documents/:id/translate", async (req, res) => {
    try {
      const id = parseInt(req.params.id);
      const { priority = 10 } = req.body; // Number of sentences to translate with priority

      const document = await storage.getDocument(id);
      if (!document) {
        return res.status(404).json({ message: "Document not found" });
      }

      // Start translation in background
      translateDocumentSentences(
        id,
        document.sourceLanguage,
        document.targetLanguage,
        priority,
      );

      res.json({ message: "Translation started", documentId: id });
    } catch (error) {
      console.error("Document translation request error:", error);
      res.status(500).json({ message: "Failed to start document translation" });
    }
  });

