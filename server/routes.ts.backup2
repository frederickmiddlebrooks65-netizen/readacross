            },
            {
              role: "user",
              content: backTranslationPrompt,
            },
          ],
          temperature: 0.3,
          max_tokens: 300,
        });

        const responseText = completion.choices[0]?.message?.content?.trim();
        if (!responseText) {
          throw new Error("Empty response from GPT");
        }

        let evaluation;
        try {
          evaluation = JSON.parse(responseText);
        } catch (parseError) {
          // Fallback evaluation
          evaluation = {
            score: 7,
            feedback:
              "역번역 연습을 완료했습니다. 의미가 대체로 잘 보존되었습니다.",
          };
        }

        // Save back translation attempt
        const backTranslationAttempt = await storage.createTranslationAttempt({
          sentenceId,
          userId,
          userTranslation: userBackTranslation,
          score: evaluation.score,
          grade: null,
          feedback: evaluation.feedback,
          suggestedCorrection: null,
          backTranslation: null,
          backTranslationFeedback: null,
          practiceMode: "individual",
          mode: "back-translation",
          timeSpent: null,
          isCorrect: evaluation.score >= 7,
        });

        res.json({
          score: evaluation.score,
          feedback: evaluation.feedback,
          attemptId: backTranslationAttempt.id,
        });
      } catch (openaiError: any) {
        console.error("OpenAI API error:", openaiError);
        // Fallback response with attempt saving
        const backTranslationAttempt = await storage.createTranslationAttempt({
          sentenceId,
          userId,
          userTranslation: userBackTranslation,
          score: 7,
          grade: null,
          feedback: "역번역 연습을 완료했습니다. 의미 보존이 잘 되었습니다.",
          suggestedCorrection: null,
          backTranslation: null,
          backTranslationFeedback: null,
          practiceMode: "individual",
          mode: "back-translation",
          timeSpent: null,
          isCorrect: true,
        });

        res.json({
          score: 7,
          feedback: "역번역 연습을 완료했습니다. 의미 보존이 잘 되었습니다.",
          attemptId: backTranslationAttempt.id,
        });
      }
    } catch (error) {
      console.error("Error performing back translation:", error);
      res.status(500).json({ error: "Failed to perform back translation" });
    }
  });

  // Get translation history for a sentence
  app.get("/api/sentences/:id/history", async (req, res) => {
