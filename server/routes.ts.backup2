      if (!sentenceId || score === undefined || !userTranslation) {
        return res.status(400).json({
          error: "sentenceId, score, and userTranslation are required",
        });
      }

      // Save the translation attempt
      const translationAttempt = await storage.createTranslationAttempt({
        sentenceId,
        userId,
        userTranslation,
        score,
        isCorrect: score >= 7, // Consider 7+ as correct
        mode: "review",
        feedback: null,
        grade: null,
        suggestedCorrection: null,
        backTranslation: null,
        backTranslationFeedback: null,
        practiceMode: "individual",
        timeSpent: sessionTime || null,
      });

      // Update sentence practice data
      const updates: any = {
        practiced: true,
        lastPracticedAt: new Date(),
      };

      // If needsReview is true, increase the review priority
      if (needsReview) {
        updates.reviewPriority = (updates.reviewPriority || 0) + 1;
      }

      const updatedSentence = await storage.updateSentence(sentenceId, updates);

      res.json({
        success: true,
        attemptId: translationAttempt.id,
        sentence: updatedSentence,
        sessionTime: sessionTime || 0,
      });
    } catch (error) {
      console.error("Error saving review result:", error);
      res.status(500).json({ error: "Failed to save review result" });
    }
  });

  // Helper function to detect text type for style-specific translation
  // Enhanced text type detection using GPT for better accuracy
  async function detectTextType(
    text: string,
  ): Promise<"literature" | "academic" | "news"> {
    try {
      // Extract sample text (first 500-1000 characters for analysis)
      const sampleText = text.substring(0, Math.min(1000, text.length));

      const detectPrompt = `You are an expert in text classification.
Classify the following text into one of three categories:
- literature (novel, essay, literary text, creative writing)
- academic (research paper, technical document, scientific text)
- news (article, report, column, journalism)

Return only one category in lowercase.

Text:
"""
${sampleText}
"""`;

      const response = await openai.chat.completions.create({
        model: "gpt-4o",
        messages: [
          {
            role: "system",
            content:
              "You are a text classification expert. Respond with only one word: literature, academic, or news.",
          },
          {
            role: "user",
            content: detectPrompt,
          },
        ],
        temperature: 0.1,
        max_tokens: 10,
      });

      const detectedType = response.choices[0].message.content
        ?.trim()
        .toLowerCase();

      // Validate the response and provide fallback
      if (
        detectedType === "literature" ||
        detectedType === "academic" ||
        detectedType === "news"
      ) {
        return detectedType as "literature" | "academic" | "news";
      }

      // Fallback to simple keyword detection if GPT response is invalid
      return fallbackTextType(text);
    } catch (error) {
      console.error("GPT text type detection failed, using fallback:", error);
      return fallbackTextType(text);
    }
  }

  // Fallback text type detection using keywords
  function fallbackTextType(text: string): "literature" | "academic" | "news" {
    const lowerText = text.toLowerCase();

    // Academic indicators
    if (
      text.includes("research") ||
      text.includes("study") ||
      text.includes("analysis") ||
      text.includes("methodology") ||
      text.includes("conclusion") ||
      text.includes("abstract") ||
      lowerText.includes("therefore") ||
      lowerText.includes("furthermore") ||
      lowerText.includes("however")
    ) {
      return "academic";
    }

    // News indicators
    if (
      lowerText.includes("said") ||
      lowerText.includes("according to") ||
      lowerText.includes("reported") ||
      lowerText.includes("announced") ||
      text.match(/\b\d{4}\b/) ||
      text.match(
        /\b(january|february|march|april|may|june|july|august|september|october|november|december)\b/i,
      )
    ) {
      return "news";
    }

    // Default to literature for creative and narrative texts
    return "literature";
  }

  // 중복 함수 제거됨 - 메인 generateStructuredContentWithAnchors 함수 사용

  // Helper function to get style-specific system prompt
  function getStylePrompt(
    textType: "literature" | "academic" | "news",
    sourceLanguage: string,
    targetLanguage: string,
  ): string {
    const basePrompt = `You are a professional Korean translator specializing in ${textType} texts.
Translate the following text from ${sourceLanguage} to ${targetLanguage} with high quality and naturalness.

CRITICAL REQUIREMENTS:
- Remove ALL semicolons (;) and replace with appropriate Korean punctuation (마침표 or 쉼표)
- Convert English-style dashes (—) to Korean spacing or punctuation
- Use ONLY informal tone (일반체) consistently throughout - NO honorific endings
- Ensure natural Korean sentence flow and readability
- Preserve the exact meaning while improving Korean expression
- MANDATORY: Use only ~다/~는다/~했다 endings, NEVER use ~습니다/~입니다/~됩니다`;

    switch (textType) {
      case "literature":
        return `${basePrompt}

LITERARY STYLE GUIDELINES:
- Use ONLY informal Korean endings (했다/된다/이다 style throughout)
- Maintain elegant, flowing Korean prose while keeping informal tone
- Preserve the author's unique voice and emotional tone
- Maintain narrative rhythm and pacing in Korean
- Use rich, expressive vocabulary appropriate to the genre
- Ensure dialogue feels natural in Korean context
- Keep paragraph structure that flows well in Korean
- CRITICAL: Consistent informal tone - 했다, 됐다, 보였다, 말했다 (NO 했습니다/됐습니다)

Return only the refined Korean translation in consistent informal tone.`;

      case "academic":
        return `${basePrompt}

ACADEMIC STYLE GUIDELINES:
- Use ONLY informal academic endings (이다/되다/한다 style, NO 입니다/됩니다 endings)
- Use precise, scholarly Korean terminology with informal endings
- Maintain objective tone but with informal grammar structure
- Ensure clarity and logical progression of ideas
- Use consistent technical vocabulary with informal endings
- Structure sentences for academic readability
- Avoid both colloquialisms and honorific forms
- CRITICAL: Consistent informal declarative tone (예: 이다, 된다, 한다, 보인다)

Return only the refined Korean translation in consistent informal tone.`;

      case "news":
        return `${basePrompt}

JOURNALISTIC STYLE GUIDELINES:
- Use ONLY informal reporting style (했다/됐다 endings, NO 했습니다/됐습니다)
- Use clear, neutral Korean for broad accessibility with informal grammar
- Maintain factual, objective reporting tone
- Keep sentences concise and informative
- Use standard Korean news writing conventions with informal endings
- Ensure immediate comprehension for general readers
- Present information in logical Korean structure
- CRITICAL: Consistent informal journalistic tone (했다, 됐다, 말했다, 발표했다)

Return only the refined Korean translation in consistent informal tone.`;
    }
  }

  // Helper function to post-process translation for Korean style
  async function postProcessTranslation(
    translatedText: string,
  ): Promise<string> {
    try {
      const refinementPrompt = `Refine the following Korean translation to improve naturalness and consistency:

Guidelines:
- Remove any semicolons (;) and replace with appropriate Korean punctuation
- Fix any tone inconsistencies (ensure consistent formal tone)
- Improve sentence flow and readability
- Correct any awkward Korean expressions
- Maintain the original meaning exactly

Original translation: "${translatedText}"

Return only the refined Korean text without explanations.`;

      const response = await openai.chat.completions.create({
        model: "gpt-4o-mini", // Use smaller model for post-processing to save costs
        messages: [
          {
            role: "system",
            content:
              "You are a Korean language editor specializing in improving translation quality and naturalness.",
          },
          {
            role: "user",
            content: refinementPrompt,
          },
        ],
        temperature: 0.2, // Very low temperature for consistent editing
      });

      return response.choices[0].message.content?.trim() || translatedText;
    } catch (error) {
      console.error("Post-processing error:", error);
      // Fallback: simple punctuation cleanup
      return translatedText.replace(/;/g, ".").replace(/—/g, " — ");
    }
  }

  // Helper function to translate text using OpenAI with caching and improved quality
  async function translateText(
    text: string,
    sourceLanguage: string,
    targetLanguage: string,
  ): Promise<string> {
    try {
      // First check if we already have this translation in the cache
      const cachedTranslation = await storage.findTranslation(
        text,
        sourceLanguage,
        targetLanguage,
      );

      if (cachedTranslation) {
        console.log(
          `Using cached translation for text: "${text.substring(0, 30)}..."`,
        );
        // Update usage count and return cached translation
        await storage.updateTranslationUsage(cachedTranslation.id);
        return cachedTranslation.targetText;
      }

      // If not in cache, perform enhanced translation with API
      console.log(`Translating new text: "${text.substring(0, 30)}..."`);

      // Step 1: Detect text type using enhanced GPT-based detection
      const textType = await detectTextType(text);
      console.log(`Detected text type: ${textType}`);

      // Step 2: Get style-specific prompt with enhanced quality guidelines
      const systemPrompt = getStylePrompt(
        textType,
        sourceLanguage,
        targetLanguage,
      );

      // Step 3: Perform single-pass high-quality translation (no post-processing)
      const response = await openai.chat.completions.create({
        model: "gpt-4o",
        messages: [
          {
            role: "system",
            content: systemPrompt,
          },
          {
            role: "user",
            content: text,
          },
        ],
        temperature: 0.3, // Balanced temperature for natural but consistent translation
      });

      const translatedText = response.choices[0].message.content || text;

      // Step 4: Apply minimal local cleanup (no GPT post-processing)
      const finalTranslation = applyLocalCleanup(translatedText);

      // Save the final translation to cache
      await storage.saveTranslation({
        sourceText: text,
        targetText: finalTranslation,
        sourceLanguage,
        targetLanguage,
      });

      return finalTranslation;
    } catch (error) {
      console.error("Translation error:", error);
      return text; // Return original text as fallback
    }
  }

  // Local cleanup function (replaces GPT post-processing for efficiency)
  function applyLocalCleanup(translatedText: string): string {
    return (
      translatedText
        // Remove semicolons and replace with periods
        .replace(/;/g, ".")
        // Clean up English-style dashes
        .replace(/—/g, " — ")
        .replace(/--/g, " — ")
        // Clean up excessive whitespace
        .replace(/\s+/g, " ")
        .trim()
    );
  }

  // Enhanced background translation process for documents with text type detection
  async function translateDocumentSentences(
    documentId: number,
    sourceLanguage: string,
    targetLanguage: string,
    priorityCount: number = 10, // Number of sentences to translate with priority
  ) {
    try {
      const document = await storage.getDocumentWithParagraphs(documentId);
      if (!document) return;

      // Step 1: Detect document text type using first 1000 characters
      let sampleText = "";
      for (const paragraph of document.paragraphs) {
        for (const sentence of paragraph.sentences) {
          sampleText += sentence.source + " ";
          if (sampleText.length >= 1000) break;
        }
        if (sampleText.length >= 1000) break;
      }

      const documentTextType = await detectTextType(sampleText);
      console.log(
        `Document ${documentId} detected as: ${documentTextType} type`,
      );

      let totalSentences = 0;
      let processedSentences = 0;
      let prioritySentences: Array<{ id: number; source: string }> = [];
      let remainingSentences: Array<{
        paragraphIndex: number;
        sentenceIndex: number;
      }> = [];

      console.log(
        `Starting enhanced translation for document ${documentId} (${documentTextType}) with priority for first ${priorityCount} sentences`,
      );

      // Count total sentences and identify priority sentences
      document.paragraphs.forEach((paragraph, paragraphIndex) => {
        paragraph.sentences.forEach((sentence, sentenceIndex) => {
          totalSentences++;

          // Skip already translated sentences
          if (sentence.target) {
            processedSentences++;
            return;
          }

          // Add to priority list if still under limit
          if (prioritySentences.length < priorityCount) {
            prioritySentences.push({
              id: sentence.id,
              source: sentence.source,
            });
          } else {
            // Add to remaining sentences
            remainingSentences.push({
              paragraphIndex,
              sentenceIndex,
            });
          }
        });
      });

      // Update initial progress
      if (totalSentences > 0) {
        const initialProgress = Math.floor(
          (processedSentences / totalSentences) * 100,
        );
        await storage.updateDocumentProgress(documentId, initialProgress);
      }

      // First, translate priority sentences
      if (prioritySentences.length > 0) {
        console.log(
          `Translating ${prioritySentences.length} priority sentences first`,
        );

        await Promise.all(
          prioritySentences.map(async ({ id, source }) => {
            try {
              // Try to find in translation cache first
              const cachedTranslation = await storage.findTranslation(
                source,
                sourceLanguage,
                targetLanguage,
              );

              let translation;
              if (cachedTranslation) {
                // If found in cache, use it directly
                console.log(
                  `Using cached translation for priority sentence ID ${id}`,
                );
                translation = cachedTranslation.targetText;

                // Update cache usage statistics
                await storage.updateTranslationUsage(cachedTranslation.id);
              } else {
                // If not in cache, translate the sentence
                translation = await translateText(
                  source,
                  sourceLanguage,
                  targetLanguage,
                );
              }

              // Update the sentence with the translation
              await storage.updateSentence(id, { target: translation });

              // Update progress
              processedSentences++;
              const progress = Math.floor(
                (processedSentences / totalSentences) * 100,
              );
              await storage.updateDocumentProgress(documentId, progress);
            } catch (error) {
              console.error(
                `Failed to translate priority sentence ${id}:`,
                error,
              );
            }
          }),
        );
      }

      // Then process remaining sentences in batches
      if (remainingSentences.length > 0) {
        console.log(
          `Processing remaining ${remainingSentences.length} sentences in batches`,
        );

        // Process sentences in batches to avoid rate limits
        const batchSize = 5;
        for (let i = 0; i < remainingSentences.length; i += batchSize) {
          const batch = remainingSentences.slice(i, i + batchSize);

          // Translate each sentence in the batch
          await Promise.all(
            batch.map(async ({ paragraphIndex, sentenceIndex }) => {
              try {
                const sentence =
                  document.paragraphs[paragraphIndex].sentences[sentenceIndex];

                // Skip if already translated (double check)
                if (sentence.target) return;

                // Try to find in translation cache first
                const cachedTranslation = await storage.findTranslation(
                  sentence.source,
                  sourceLanguage,
                  targetLanguage,
                );

                let translation;
                if (cachedTranslation) {
                  // If found in cache, use it directly
                  console.log(
                    `Using cached translation for sentence ID ${sentence.id}`,
                  );
                  translation = cachedTranslation.targetText;

                  // Update cache usage statistics
                  await storage.updateTranslationUsage(cachedTranslation.id);
                } else {
                  // If not in cache, translate the sentence
                  translation = await translateText(
                    sentence.source,
                    sourceLanguage,
                    targetLanguage,
                  );
                }

                // Update the sentence with the translation
                await storage.updateSentence(sentence.id, {
                  target: translation,
                });

                // Update progress
                processedSentences++;
                const progress = Math.floor(
                  (processedSentences / totalSentences) * 100,
                );
                await storage.updateDocumentProgress(documentId, progress);
              } catch (error) {
                console.error(`Failed to translate sentence in batch:`, error);
              }
            }),
          );

          // Sleep between batches to avoid rate limits
          await new Promise((resolve) => setTimeout(resolve, 1000));
        }
      }

      // Ensure progress is 100% when done
      await storage.updateDocumentProgress(documentId, 100);
    } catch (error) {
      console.error(`Failed to translate document ${documentId}:`, error);
    }
  }
}

async function addLibraryRoutes(app: any) {
  // API Routes - Documents
  app.get("/api/documents", async (_req: any, res: any) => {
    try {
      const documents = await storage.getAllDocuments();
      // Filter to show only user documents (not public library content)
      const userDocuments = documents.filter((doc: any) => !doc.isPublic);
      res.json(userDocuments);
    } catch (error) {
      console.error("Error fetching documents:", error);
      res.status(500).json({ message: "Failed to fetch documents" });
    }
  });

  // API Routes - Public Library
  app.get("/api/library/explore", async (req: any, res: any) => {
    try {
      const { category, difficulty, sortBy = "latest" } = req.query;

      console.log("Library explore request:", { category, difficulty, sortBy });

      // Debug category filtering
      if (category && category !== "all") {
        console.log(`[CATEGORY_DEBUG] Filtering by category: ${category}`);
      }

      const publicDocuments = await storage.getPublicLibraryDocuments({
        category: category as string,
        difficulty: difficulty as string,
        sortBy: sortBy as string,
      });

      console.log(`Found ${publicDocuments.length} public documents`);

      res.json(publicDocuments);
    } catch (error) {
      console.error("Error fetching public library documents:", error);
      res.status(500).json({ message: "Failed to fetch library documents" });
    }
  });

  // Seed Gutenberg books
  app.post("/api/library/seed-gutenberg", async (_req: any, res: any) => {
    try {
      const { seedGutenbergBooks } = await import("./gutenbergCrawler.js");
      await seedGutenbergBooks();
      res.json({ message: "Successfully seeded Gutenberg books" });
    } catch (error) {
      console.error("Error seeding Gutenberg books:", error);
      res.status(500).json({ message: "Failed to seed Gutenberg books" });
    }
  });

  // Seed arXiv papers
  app.post("/api/library/seed-arxiv", async (_req: any, res: any) => {
    try {
      const { seedArxivPapers } = await import("./arxivCrawler.js");
      await seedArxivPapers();
      res.json({ message: "Successfully seeded arXiv papers" });
    } catch (error) {
      console.error("Error seeding arXiv papers:", error);
      res.status(500).json({ message: "Failed to seed arXiv papers" });
    }
  });

  // Update existing document categories to English
  app.post("/api/library/update-categories", async (_req: any, res: any) => {
    try {
      const updates = [
        { from: "뉴스", to: "News" },
        { from: "문학", to: "Literature" },
        { from: "논문", to: "Academic" },
        { from: "에세이/오피니언", to: "Opinion" },
        { from: "칼럼·에세이", to: "Opinion" },
        { from: "교육", to: "Educational" },
        { from: "기타", to: "Other" },
        { from: "classic", to: "Literature" },
        { from: "science", to: "Academic" },
        { from: "Non-fiction", to: "Opinion" },
      ];

      let totalUpdated = 0;

      for (const update of updates) {
        const result = await db
          .update(documents)
          .set({ category: update.to })
          .where(eq(documents.category, update.from))
          .returning({ id: documents.id });

        totalUpdated += result.length;
      }

      res.json({
        message: `Successfully updated ${totalUpdated} document categories to English`,
        updatedCount: totalUpdated,
      });
    } catch (error) {
      console.error("Error updating categories:", error);
      res.status(500).json({ message: "Failed to update categories" });
    }
  });

  // Cleanup expired documents
  app.post("/api/library/cleanup", async (_req: any, res: any) => {
    try {
      const deletedCount = await storage.cleanupExpiredDocuments();
      res.json({
        message: `Successfully cleaned up ${deletedCount} expired documents`,
        deletedCount,
      });
    } catch (error) {
      console.error("Error cleaning up documents:", error);
      res.status(500).json({ message: "Failed to clean up documents" });
    }
  });

  // Manual delete public library document (admin only)
  app.delete("/api/library/documents/:id", async (req: any, res: any) => {
    try {
      const documentId = parseInt(req.params.id);

      // Verify it's a public document
      const document = await storage.getDocument(documentId);
      if (!document) {
        return res.status(404).json({ message: "Document not found" });
      }

      if (!document.isPublic) {
        return res
          .status(403)
          .json({ message: "Can only delete public library documents" });
      }

      const success = await storage.deleteDocument(documentId);

      if (success) {
        res.json({
          success: true,
          message: "Public document deleted successfully",
        });
      } else {
        res.status(500).json({ message: "Failed to delete document" });
      }
    } catch (error) {
      console.error("Error deleting public document:", error);
      res.status(500).json({ message: "Failed to delete document" });
    }
  });

  // Set expiration dates for existing public documents
  app.post("/api/library/set-expiration-dates", async (_req: any, res: any) => {
    try {
      const updatedCount =
        await storage.setExpirationDatesForExistingDocuments();
      res.json({
        message: `Successfully set expiration dates for ${updatedCount} public documents`,
        updatedCount,
      });
    } catch (error) {
      console.error("Error setting expiration dates:", error);
      res.status(500).json({ message: "Failed to set expiration dates" });
